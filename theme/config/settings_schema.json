      { "type": "header", "content": "Samstag" },
      { "type": "range", "id": "hours_sat_from", "label": "Von", "min": 0, "max": 23, "step": 1, "unit": "Uhr", "default": 9 },
      { "type": "range", "id": "hours_sat_to", "label": "Bis", "min": 0, "max": 24, "step": 1, "unit": "Uhr", "default": 14 }
