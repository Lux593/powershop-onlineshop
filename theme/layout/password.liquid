<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <meta name="theme-color" content="#0a0a0a">
    <link rel="icon" href="{{ 'power-shop-signet.svg' | asset_url }}" type="image/svg+xml">
    {% render 'fonts' %}
    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body data-template="password">
    <main id="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
