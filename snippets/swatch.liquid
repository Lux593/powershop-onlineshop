{% doc %}
  Farbfeld für eine Farb-Option. Reihenfolge: natives Shopify-Swatch (Farbe/Bild), Variantenbild der ersten
  passenden Variante, Metaobjekt Farbe (Handle = Name), Farbname (inkl. „ / “-Kombinationen), sonst grau.

  @param {string} name - Farbname, z. B. „Schwarz“ oder „Weiß / Rot / Blau“
  @param {object} [swatch] - Swatch des Optionswerts (value.swatch)
  @param {image} [variant_image] - Produktbild der ersten Variante mit diesem Wert
  @param {string} [tag] - „li“ (Standard) oder „span“
{% enddoc %}

{%- liquid
  assign bg = blank

  if swatch.image != blank
    assign bg = 'url(' | append: swatch.image | image_url: width: 128 | append: ') center / cover'
  elsif swatch.color != blank
    assign bg = swatch.color
  endif

  if bg == blank and variant_image != blank
    assign bg = 'url(' | append: variant_image | image_url: width: 128 | append: ') center / cover'
  endif

  if bg == blank
    assign entry_handle = name | handleize
    assign meta_hex = metaobjects['shopify--color-pattern'][entry_handle].color.value
    if meta_hex != blank
      assign bg = meta_hex
    endif
  endif

  if bg == blank
    assign combo = name | split: ' / '
    if combo.size > 1
      assign stops = ''
      assign n = combo.size
      for part in combo
        capture part_hex
          render 'swatch-hex', label: part
        endcapture
        assign part_hex = part_hex | strip
        assign i = forloop.index0
        assign start_pct = i | times: 100 | divided_by: n
        assign end_pct = forloop.index | times: 100 | divided_by: n
        if forloop.first
          assign stops = part_hex | append: ' ' | append: start_pct | append: '% ' | append: end_pct | append: '%'
        else
          assign stops = stops | append: ', ' | append: part_hex | append: ' ' | append: start_pct | append: '% ' | append: end_pct | append: '%'
        endif
      endfor
      assign bg = 'linear-gradient(90deg, ' | append: stops | append: ')'
    else
      capture single_hex
        render 'swatch-hex', label: name
      endcapture
      assign bg = single_hex | strip
    endif
  endif

  if bg == blank
    assign bg = '#cccccc'
  endif

  assign element = tag | default: 'li'
-%}
<{{ element }} class="swatch" style="background:{{ bg }}" title="{{ name | escape }}"></{{ element }}>
