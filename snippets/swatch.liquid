{% doc %}
  Farbfeld für eine Farb-Option. Reihenfolge: Shopify-Swatch-Farbe der verknüpften Option, dann der Farbeintrag mit
  gleichem Namen unter Inhalte > Metaobjekte > Farbe (Handle = Name als Handle, z. B. "vivid-black"),
  sonst eine Zuordnung nach Farbname.

  @param {string} name - Farbname, z. B. "Schwarz"
  @param {object} [swatch] - Swatch des Optionswerts (value.swatch)
  @param {string} [tag] - "li" (Standard) oder "span"
{% enddoc %}

{%- liquid
  assign hex = swatch.color
  if hex == blank
    assign entry_handle = name | handleize
    assign hex = metaobjects['shopify--color-pattern'][entry_handle].color.value
  endif
  if hex == blank
    assign key = name | downcase
    case key
      when 'schwarz', 'black', 'vivid black', 'gloss black', 'matte black'
        assign hex = '#141414'
      when 'braun', 'brown'
        assign hex = '#6b4226'
      when 'grau', 'gray', 'grey', 'dark billiard gray', 'billiard gray', 'silber', 'silver'
        assign hex = '#8a8a8a'
      when 'oliv', 'olive'
        assign hex = '#5b5e3a'
      when 'weiß', 'weiss', 'white'
        assign hex = '#f4f4f2'
      when 'orange'
        assign hex = '#f26722'
      when 'bordeaux', 'burgundy', 'wine'
        assign hex = '#7d1f24'
      when 'rot', 'red', 'brilliant red'
        assign hex = '#b3262e'
      when 'denim', 'aurora blue denim'
        assign hex = '#3d5a80'
      when 'blau', 'blue'
        assign hex = '#2f66a8'
      when 'sand', 'beige', 'tan'
        assign hex = '#c8b79a'
      when 'chrom', 'chrome', 'polished chrome'
        assign hex = '#c9ccd1'
      when 'gelb', 'yellow', 'gold'
        assign hex = '#d4a017'
      when 'grün', 'gruen', 'green'
        assign hex = '#2d6a4f'
      when 'lila', 'purple', 'violet'
        assign hex = '#5c4d7d'
      else
        if key contains 'schwarz' or key contains 'black'
          assign hex = '#141414'
        elsif key contains 'orange'
          assign hex = '#f26722'
        elsif key contains 'rot' or key contains 'red'
          assign hex = '#b3262e'
        elsif key contains 'blau' or key contains 'blue'
          assign hex = '#2f66a8'
        elsif key contains 'grau' or key contains 'gray' or key contains 'grey'
          assign hex = '#8a8a8a'
        elsif key contains 'weiß' or key contains 'weiss' or key contains 'white'
          assign hex = '#f4f4f2'
        elsif key contains 'chrom' or key contains 'chrome'
          assign hex = '#c9ccd1'
        else
          assign hex = '#cccccc'
        endif
    endcase
  endif
  assign bg = hex
  if swatch.image != blank
    assign bg = 'url(' | append: swatch.image | image_url: width: 64 | append: ') center / cover'
  endif
  assign element = tag | default: 'li'
-%}
<{{ element }} class="swatch" style="background:{{ bg }}" title="{{ name | escape }}"></{{ element }}>
