{% doc %}
  Farbfeld für eine Farb-Option. Reihenfolge: natives Shopify-Swatch (Farbe/Bild), Metaobjekt Farbe (Handle = Name),
  Farbname (inkl. „ / “ als geteilter Kreis via conic-gradient), sonst grau.

  @param {string} name - Farbname, z. B. „Schwarz“ oder „Weiß / Rot / Blau“
  @param {object} [swatch] - Swatch des Optionswerts (value.swatch)
  @param {string} [tag] - „li“ (Standard) oder „span“
{% enddoc %}

{%- liquid
  assign bg = blank

  if swatch.image != blank
    assign bg = 'url(' | append: swatch.image | image_url: width: 128 | append: ') center / cover'
  elsif swatch.color != blank
    assign bg = swatch.color
  endif

  if bg == blank
    assign entry_handle = name | handleize
    assign meta_hex = metaobjects['shopify--color-pattern'][entry_handle].color.value
    if meta_hex != blank
      assign bg = meta_hex
    endif
  endif

  if bg == blank
    assign combo = name | split: ' / '
    if combo.size > 1
      assign stops = ''
      assign n = combo.size
      assign slice = 360 | divided_by: n
      for part in combo
        capture part_hex
          render 'swatch-hex', label: part
        endcapture
        assign part_hex = part_hex | strip
        assign start_deg = forloop.index0 | times: slice
        assign end_deg = forloop.index | times: slice
        assign stop = part_hex | append: ' ' | append: start_deg | append: 'deg ' | append: end_deg | append: 'deg'
        if forloop.first
          assign stops = stop
        else
          assign stops = stops | append: ', ' | append: stop
        endif
      endfor
      assign bg = 'conic-gradient(' | append: stops | append: ')'
    else
      capture single_hex
        render 'swatch-hex', label: name
      endcapture
      assign bg = single_hex | strip
    endif
  endif

  if bg == blank
    assign bg = '#cccccc'
  endif

  assign element = tag | default: 'li'
-%}
<{{ element }} class="swatch" style="background:{{ bg }}" title="{{ name | escape }}"></{{ element }}>
