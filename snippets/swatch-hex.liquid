{% doc %}
  Liefert eine Hex-Farbe für einen einzelnen Farbnamen (ein Segment, kein „ / “).
  @param {string} label - z. B. „Grün“, „Orange“
{% enddoc %}
{%- liquid
  assign key = label | strip | downcase
  assign hex = blank
  case key
    when 'schwarz', 'black', 'vivid black', 'gloss black', 'matte black'
      assign hex = '#141414'
    when 'braun', 'brown'
      assign hex = '#6b4226'
    when 'grau', 'gray', 'grey', 'dark billiard gray', 'billiard gray', 'silber', 'silver'
      assign hex = '#8a8a8a'
    when 'oliv', 'olive'
      assign hex = '#5b5e3a'
    when 'weiß', 'weiss', 'white'
      assign hex = '#f4f4f2'
    when 'orange'
      assign hex = '#f26722'
    when 'bordeaux', 'burgundy', 'wine'
      assign hex = '#7d1f24'
    when 'rot', 'red', 'brilliant red'
      assign hex = '#b3262e'
    when 'denim', 'aurora blue denim'
      assign hex = '#3d5a80'
    when 'blau', 'blue'
      assign hex = '#2f66a8'
    when 'dunkelblau', 'dark blue', 'navy'
      assign hex = '#1e3a5f'
    when 'hellblau', 'light blue', 'himmelblau'
      assign hex = '#7ec8e3'
    when 'türkis', 'tuerkis', 'turquoise', 'turkisfarben'
      assign hex = '#2aa9a1'
    when 'sand', 'beige', 'tan'
      assign hex = '#c8b79a'
    when 'chrom', 'chrome', 'polished chrome'
      assign hex = '#c9ccd1'
    when 'gelb', 'yellow', 'gold'
      assign hex = '#d4a017'
    when 'grün', 'gruen', 'green'
      assign hex = '#2d6a4f'
    when 'lila', 'purple', 'violet'
      assign hex = '#5c4d7d'
    else
      if key contains 'schwarz' or key contains 'black'
        assign hex = '#141414'
      elsif key contains 'orange'
        assign hex = '#f26722'
      elsif key contains 'rot' or key contains 'red'
        assign hex = '#b3262e'
      elsif key contains 'dunkelblau' or key contains 'navy'
        assign hex = '#1e3a5f'
      elsif key contains 'hellblau'
        assign hex = '#7ec8e3'
      elsif key contains 'türkis' or key contains 'tuerkis' or key contains 'turquoise'
        assign hex = '#2aa9a1'
      elsif key contains 'blau' or key contains 'blue'
        assign hex = '#2f66a8'
      elsif key contains 'grau' or key contains 'gray' or key contains 'grey'
        assign hex = '#8a8a8a'
      elsif key contains 'grün' or key contains 'gruen' or key contains 'green'
        assign hex = '#2d6a4f'
      elsif key contains 'gelb' or key contains 'yellow'
        assign hex = '#d4a017'
      elsif key contains 'weiß' or key contains 'weiss' or key contains 'white'
        assign hex = '#f4f4f2'
      elsif key contains 'chrom' or key contains 'chrome'
        assign hex = '#c9ccd1'
      else
        assign hex = '#cccccc'
      endif
  endcase
-%}{{- hex -}}
