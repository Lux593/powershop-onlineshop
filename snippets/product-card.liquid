{% doc %}
  Produktkarte für Bekleidung, Teile und Accessoires (.pcard).
  Motorräder nutzen stattdessen das Snippet bike-card.

  @param {product} product - Produkt
  @param {string} [sizes] - sizes-Attribut für die Bilder
  @param {string} [loading] - "lazy" (Standard) oder "eager"
  @param {boolean} [reveal] - Karte blendet beim Scrollen ein (data-reveal, Stagger über die Spalte in shop.css)

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{%- liquid
  assign img_loading = loading | default: 'lazy'
  # Nur lazy ausgegebene Hauptbilder blenden beim Laden ein (shop.css, .fade-on-load). Ein Vorlader stellt sie später auf eager, das Merkmal bleibt.
  assign img_class = 'pcard__img'
  if img_loading == 'lazy'
    assign img_class = 'pcard__img fade-on-load'
  endif
  assign img_sizes = sizes | default: '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw'

  assign is_part = false
  if product.metafields.part.teilenummer != blank or product.template_suffix == 'teil'
    assign is_part = true
  endif

  # Nur auf Anfrage (snippets/on-request.liquid): kein Schnellkauf, dafür das Etikett „Auf Anfrage“
  capture card_on_request
    render 'on-request', product: product
  endcapture
  assign card_on_request = card_on_request | strip

  assign size_option = nil
  assign color_option = nil
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'größe' or option_name == 'grösse' or option_name == 'groesse' or option_name == 'size' or option_name == 'weite'
      assign size_option = option
    elsif option_name == 'farbe' or option_name == 'color'
      assign color_option = option
    endif
  endfor

  assign card_title = product.title | escape

  assign discount = 0
  if product.compare_at_price > product.price
    assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif
  assign is_new = false
  if product.tags contains 'neu'
    assign is_new = true
  endif
-%}

<article class="pcard" data-product-id="{{ product.id }}"{% if reveal %} data-reveal{% endif %}>
  <div class="pcard__media">
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 900
          | image_tag: class: img_class, alt: '', loading: img_loading, sizes: img_sizes, widths: '300, 450, 600, 900', onload: "this.classList.add('is-loaded')"
        }}
        {%- assign second_image = product.images[1] -%}
        {%- if second_image -%}
          {{
            second_image
            | image_url: width: 900
            | image_tag: class: 'pcard__img pcard__img--alt', alt: '', loading: 'lazy', sizes: img_sizes, widths: '300, 450, 600, 900'
          }}
        {%- endif -%}
      {%- endif -%}
    </a>

    {%- if is_new or discount > 0 or product.available == false or card_on_request == 'true' -%}
      <div class="pcard__badges">
        {%- if product.available == false -%}<span class="badge badge--used">Ausverkauft</span>{%- endif -%}
        {%- if card_on_request == 'true' and product.available %}<span class="badge badge--request">Auf Anfrage</span>{% endif -%}
        {%- if is_new and product.available %}<span class="badge">Neu</span>{% endif -%}
        {%- if discount > 0 and product.available %}<span class="badge badge--sale">-{{ discount }} %</span>{% endif -%}
      </div>
    {%- endif -%}

    {%- if product.available and card_on_request != 'true' -%}
      {%- comment -%} Der Schalter steht vor dem Panel: auf Touch und schmal führt Tab nach dem Öffnen direkt in die Größenwahl {%- endcomment -%}
      <button class="pcard__plus" type="button" data-quick-toggle aria-expanded="false" aria-label="Schnell hinzufügen: {{ product.title | escape }}">
        {% render 'icon', name: 'plus' %}
      </button>
      <div class="pcard__quick{% if size_option %} pcard__quick--sizes{% endif %}">
        {%- if size_option -%}
          {%- assign size_idx = size_option.position | minus: 1 -%}
          {%- if color_option -%}
            {%- assign color_idx = color_option.position | minus: 1 -%}
            {%- assign first_color = color_option.values.first.name | default: color_option.values.first -%}
          {%- endif -%}
          <p class="pcard__quick-label">Größe wählen &amp; in den Warenkorb</p>
          <div class="size-grid">
            {%- for variant in product.variants -%}
              {%- assign show_variant = true -%}
              {%- if color_option -%}
                {%- assign variant_color = variant.options[color_idx] -%}
                {%- if variant_color != first_color %}{% assign show_variant = false %}{% endif -%}
              {%- endif -%}
              {%- if show_variant -%}
                {%- assign variant_size = variant.options[size_idx] -%}
                {%- assign add_thumb = variant.featured_image | default: product.featured_image -%}
                <button
                  class="size-chip{% unless variant.available %} is-soldout{% endunless %}"
                  type="button"
                  data-add-variant="{{ variant.id }}"{% if add_thumb %} data-add-thumb="{{ add_thumb | image_url: width: 176 }}"{% endif %}
                  {% unless variant.available %}disabled aria-label="Größe {{ variant_size | escape }}: {{ card_title }} ausverkauft"{% else %}aria-label="Größe {{ variant_size | escape }}: {{ card_title }} in den Warenkorb"{% endunless %}
                >{{ variant_size | escape }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- elsif product.variants.size == 1 -%}
          {%- comment -%} Kurzform für schmale Karten (Handy): Der Button steht dort neben dem runden Schließen-Button (shop.css, Quick-Add) {%- endcomment -%}
          {%- assign add_thumb = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
          <button class="btn btn--secondary btn--block btn--sm pcard__add" type="button" data-add-variant="{{ product.selected_or_first_available_variant.id }}"{% if add_thumb %} data-add-thumb="{{ add_thumb | image_url: width: 176 }}"{% endif %}>
            {% render 'icon', name: 'shopping-bag' %}<span class="pcard__add-long">In den Warenkorb</span><span class="pcard__add-short">In den Korb</span><span class="sr-only">: {{ card_title }}</span></button>
        {%- else -%}
          <a class="btn btn--secondary btn--block btn--sm pcard__add" href="{{ product.url }}"><span class="pcard__add-long">Optionen wählen</span><span class="pcard__add-short">Optionen</span><span class="sr-only">: {{ card_title }}</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="pcard__body">
    <p class="caption muted">
      {%- if is_part and product.vendor != blank -%}{{ product.vendor | escape }}{%- else -%}{{ product.type | escape }}{%- endif -%}
    </p>
    <h3 class="pcard__title"><a href="{{ product.url }}">{{ card_title }}</a></h3>
    {% render 'rating', product: product %}
    {% render 'price', product: product %}
    {%- comment -%} Nur „Auf Lager“ (Bestand ab 1, bei Größen in mindestens einer), sonst nichts (snippets/delivery-info.liquid) {%- endcomment -%}
    {%- if card_on_request != 'true' -%}{% render 'delivery-info', product: product, as: 'card' %}{%- endif -%}

    {%- if is_part -%}
      {%- comment -%} Teile: keine Passform-Angabe in der Karte, sie steht auf der Produktseite (Passt-für-Karte). Keine Farbfelder. {%- endcomment -%}
    {%- elsif color_option and color_option.values.size > 1 -%}
      <ul class="swatches" aria-label="{{ color_option.values.size }} Farben">
        {%- for value in color_option.values limit: 4 -%}
          {%- assign swatch_name = value.name | default: value -%}
          {% render 'swatch', name: swatch_name, swatch: value.swatch %}
        {%- endfor -%}
        {%- if color_option.values.size > 4 -%}
          <li class="swatches__more">+{{ color_option.values.size | minus: 4 }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</article>
