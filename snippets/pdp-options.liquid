{% doc %}
  Optionszeilen der Produktseite (Farbe, Größe, Räder …) und die Variantendaten für assets/product.js.
  Farb-Optionen erscheinen als Farbfelder, alle anderen als Auswahl-Chips. Nutzt pdp-buy (im Kaufformular)
  und die Motorrad-Seite (ohne Formular, die Auswahl steuert dort Preis, Fakten und Anfrage).

  @param {product} product - Produkt
  @param {variant} [variant] - Gewählte Variante; leer = noch nichts gewählt (nur eine Farbe gilt dann als gewählt)
  @param {string} [size_type] - Tabelle in der Größentabelle: oberteile, hosen, handschuhe, helme, stiefel

  @example
  {% render 'pdp-options', product: product, variant: current_variant, size_type: 'oberteile' %}
{% enddoc %}

{%- unless product.has_only_default_variant -%}
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign option_index = option.position | minus: 1
      assign option_key = option.name | downcase
      assign is_color = false
      if option_key == 'farbe' or option_key == 'color'
        assign is_color = true
      endif
      assign selected_value = variant.options[option_index]
      if selected_value == blank and is_color
        assign selected_value = option.values.first.name | default: option.values.first
      endif
      assign is_size = false
      if option_key == 'größe' or option_key == 'groesse' or option_key == 'size' or option_key == 'weite'
        assign is_size = true
      endif
    -%}
    <div class="pdp__row" data-option-row data-option-index="{{ option_index }}" data-option-label="{{ option.name | escape }}">
      <div class="pdp__row-head">
        <span><strong>{{ option.name | escape }}:</strong> <span data-option-name>{{ selected_value | default: 'bitte wählen' | escape }}</span></span>
        {%- if is_size and size_type != blank -%}
          <button class="text-link small" type="button" data-open="sizeguide" data-type="{{ size_type }}">{% render 'icon', name: 'ruler', class: 'icon--sm' %} Größentabelle</button>
        {%- endif -%}
      </div>
      {%- if is_color -%}
        <div class="swatches" role="group" aria-label="{{ option.name | escape }} wählen">
          {%- for value in option.values -%}
            {%- liquid
              assign value_name = value.name | default: value
              assign option_prop = 'option' | append: option.position
              assign value_variants = product.variants | where: option_prop, value_name
              assign value_variant = value_variants | where: 'available' | first
              if value_variant == blank
                assign value_variant = value_variants | first
              endif
              assign value_variant_image = blank
              if value_variant != blank
                if value_variant.featured_media != blank and value_variant.featured_media.preview_image != blank
                  assign value_variant_image = value_variant.featured_media.preview_image
                elsif value_variant.featured_image != blank
                  assign value_variant_image = value_variant.featured_image
                endif
              endif
            -%}
            <button
              class="swatch-btn"
              type="button"
              data-option-value="{{ value_name | escape }}"
              aria-pressed="{% if value_name == selected_value %}true{% else %}false{% endif %}"
              aria-label="{{ value_name | escape }}"
            >{% render 'swatch', name: value_name, swatch: value.swatch, variant_image: value_variant_image, tag: 'span' %}</button>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="size-grid" role="group" aria-label="{{ option.name | escape }} wählen">
          {%- for value in option.values -%}
            {%- assign value_name = value.name | default: value -%}
            <button
              class="size-chip"
              type="button"
              data-option-value="{{ value_name | escape }}"
              aria-pressed="{% if value_name == selected_value %}true{% else %}false{% endif %}"
            >{{ value_name | escape }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
{%- endunless -%}

<script type="application/json" data-product-json>
  {
    "url": {{ product.url | json }},
    "variants": [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "options": {{ v.options | json }},
          "available": {{ v.available | json }},
          "image": {{ v.featured_image.id | default: 0 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
