{%- liquid
  comment
    Vergangene Events filtert das Snippet event-card. Chip und Abschnitt „Events“ erscheinen nur,
    wenn danach mindestens eine Karte übrig bleibt (im Theme-Editor immer alle).
  endcomment
  capture event_cards
    for block in section.blocks
      if block.type == 'event'
        render 'event-card', item: block
      endif
    endfor
  endcapture
  assign event_cards_text = event_cards | strip
  assign has_events = false
  if event_cards_text != blank
    assign has_events = true
  endif
  assign events_rendered = false

  comment
    Der Standort-Block erscheint erst, wenn Händlerdaten gepflegt sind (im Theme-Editor immer).
  endcomment
  assign location_has_data = request.design_mode
  if settings.address != blank or settings.phone != blank or settings.whatsapp != blank or settings.email != blank or settings.hours_enabled
    assign location_has_data = true
  endif
-%}

<div class="service-page" data-section-id="{{ section.id }}">
  <section class="page-banner on-dark textured">
    <div class="container page-banner__inner">
      <div class="page-banner__text">
        <nav class="breadcrumb" aria-label="Brotkrumen">
          <ol>
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><span aria-current="page">{{ section.settings.heading | escape }}</span></li>
          </ol>
        </nav>
        <h1>{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro | escape }}</p>{%- endif -%}
      </div>
      <div class="page-banner__media">
        {%- render 'media', image: section.settings.banner_image, asset: 'service-standort.jpg', width: 1200, height: 800, sizes: '50vw', loading: 'eager' -%}
      </div>
    </div>
  </section>

  <nav class="service-nav" aria-label="Service-Themen">
    <div class="container chip-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'event' -%}
          {%- unless events_rendered -%}
            {%- assign events_rendered = true -%}
            {%- if has_events -%}<a class="chip" href="#events">Events</a>{%- endif -%}
          {%- endunless -%}
        {%- elsif block.settings.chip != blank -%}
          {%- if block.type != 'location' or location_has_data -%}
            <a class="chip" href="#{{ block.settings.anchor | default: block.id }}" {{ block.shopify_attributes }}>{{ block.settings.chip | escape }}</a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </nav>

  {%- comment -%} Jeder Block bringt seinen Container mit: Die Partner-Abschnitte (Finanzierung, Versicherung) laufen über die volle Breite. {%- endcomment -%}
  {%- assign events_rendered = false -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}

        {%- when 'service' -%}
          {%- liquid
            assign anchor = block.settings.anchor | default: block.id
            assign topic = block.settings.topic
            assign topics = 'probefahrt,finanzierung,werkstatt,inzahlungnahme,frage'
            if topic == 'werkstatt'
              assign topics = 'werkstatt,einbau,frage'
            endif
            assign bullets = block.settings.bullets | newline_to_br | split: '<br />'
            assign contact_anchor = anchor | append: '-kontakt'
          -%}
          <div class="container">
          <section class="service-block" id="{{ anchor }}" aria-labelledby="sv-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="service-block__text">
              {%- render 'media', image: block.settings.image, asset: block.settings.image_asset, width: 1200, height: 800, alt: block.settings.image_alt -%}
              <h2 id="sv-{{ block.id }}">{{ block.settings.title | escape }}</h2>
              {{ block.settings.text }}
              {%- if block.settings.bullets != blank -%}
                <ul>
                  {%- for line in bullets -%}
                    {%- assign item = line | strip | strip_newlines -%}
                    {%- if item != blank -%}<li>{% render 'icon', name: 'check' %}{{ item | escape }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.note != blank -%}<p class="small muted">{{ block.settings.note | escape }}</p>{%- endif -%}
            </div>
            {% render 'contact-box', anchor: contact_anchor, title: block.settings.contact_title, topics: topics, topic: topic %}
          </section>
          </div>

        {%- when 'partner' -%}
          {% render 'partner-offer', block: block %}

        {%- when 'event' -%}
          {%- unless events_rendered -%}
            {%- assign events_rendered = true -%}
            {%- if has_events -%}
              <div class="container">
              <section class="service-block service-block--single" id="events" aria-labelledby="sv-events-{{ section.id }}">
                <div class="service-block__text">
                  <h2 id="sv-events-{{ section.id }}">{{ section.settings.events_heading | default: 'Community erleben' | escape }}</h2>
                  {%- if section.settings.events_text != blank -%}<p>{{ section.settings.events_text | escape }}</p>{%- endif -%}
                </div>
                <div class="on-dark service-events">
                  <div class="event-grid">
                    {{ event_cards }}
                  </div>
                </div>
              </section>
              </div>
            {%- endif -%}
          {%- endunless -%}

        {%- when 'location' -%}
          {%- liquid
            assign anchor = block.settings.anchor | default: block.id
            assign contact_anchor = anchor | append: '-kontakt'
            assign map_query = settings.address | newline_to_br | replace: '<br />', ', ' | strip_html | url_encode
          -%}
          {%- if location_has_data -%}
          <div class="container">
          <section class="service-block" id="{{ anchor }}" aria-labelledby="sv-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="service-block__text">
              <h2 id="sv-{{ block.id }}">{{ block.settings.title | escape }}</h2>
              {%- if settings.address != blank -%}
                <div class="map-ph">
                  {% render 'icon', name: 'map-pin', class: 'icon--lg' %}
                  <span>
                    <a class="text-link" href="https://www.google.com/maps/search/?api=1&query={{ map_query }}" target="_blank" rel="noopener">Route in Google Maps öffnen<span class="sr-only"> (neues Fenster)</span></a>
                  </span>
                </div>
              {%- endif -%}
              {%- if settings.company != blank or settings.address != blank -%}
                <p><strong>{{ settings.company | default: shop.name | escape }}</strong>{% if settings.address != blank %}<br>{{ settings.address | escape | newline_to_br }}{% endif %}</p>
              {%- endif -%}
              {%- if settings.hours_enabled -%}
                <p>{% render 'opening-hours', as: 'inline' %}</p>
              {%- endif -%}
            </div>
            {% render 'contact-box', anchor: contact_anchor, title: block.settings.contact_title, topics: 'probefahrt,finanzierung,werkstatt,inzahlungnahme,frage', topic: 'frage' %}
          </section>
          </div>
          {%- endif -%}

    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Service-Seite",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Service" },
    { "type": "text", "id": "intro", "label": "Einleitung", "default": "Probefahrt, Finanzierung, Werkstatt und Inzahlungnahme – schreib uns per WhatsApp, E-Mail oder ruf einfach an." },
    { "type": "image_picker", "id": "banner_image", "label": "Bannerbild" },
    { "type": "header", "content": "Abschnitt Events" },
    { "type": "text", "id": "events_heading", "label": "Überschrift", "default": "Community erleben" },
    { "type": "text", "id": "events_text", "label": "Text", "default": "Gemeinsame Ausfahrten, Bike Nights und Werkstatt-Tage – komm vorbei, auch ohne eigenes Bike." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Themenblock",
      "settings": [
        { "type": "text", "id": "chip", "label": "Text im Menü", "default": "Probefahrt" },
        { "type": "text", "id": "anchor", "label": "Anker (ohne #)", "default": "probefahrt", "info": "Zum Verlinken, z. B. /pages/service#probefahrt." },
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "image_asset", "label": "Standard-Bilddatei im Theme", "default": "service-probefahrt.jpg" },
        { "type": "text", "id": "image_alt", "label": "Bildbeschreibung" },
        { "type": "text", "id": "title", "label": "Überschrift", "default": "Erst fahren, dann entscheiden" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wähle dein Wunsch-Modell. Wir nehmen uns Zeit und erklären dir alles in Ruhe.</p>" },
        { "type": "textarea", "id": "bullets", "label": "Stichpunkte (einer pro Zeile)" },
        { "type": "text", "id": "note", "label": "Kleiner Hinweis" },
        { "type": "text", "id": "contact_title", "label": "Titel der Kontakt-Box", "default": "Probefahrt anfragen" },
        {
          "type": "select",
          "id": "topic",
          "label": "Voreingestelltes Thema",
          "options": [
            { "value": "probefahrt", "label": "Probefahrt" },
            { "value": "finanzierung", "label": "Finanzierung" },
            { "value": "werkstatt", "label": "Werkstatt" },
            { "value": "inzahlungnahme", "label": "Inzahlungnahme" },
            { "value": "frage", "label": "Frage" }
          ],
          "default": "probefahrt"
        }
      ]
    },
    {
      "type": "partner",
      "name": "Partner-Angebot",
      "settings": [
        { "type": "text", "id": "chip", "label": "Text im Menü", "default": "Finanzierung" },
        { "type": "text", "id": "anchor", "label": "Anker (ohne #)", "default": "finanzierung", "info": "Zum Verlinken, z. B. /pages/service#finanzierung." },
        {
          "type": "select",
          "id": "scheme",
          "label": "Farbschema",
          "options": [
            { "value": "light", "label": "Hell" },
            { "value": "dark", "label": "Dunkel mit Körnung" }
          ],
          "default": "light"
        },
        { "type": "header", "content": "Partner-Logo" },
        { "type": "image_picker", "id": "logo", "label": "Logo (transparent)", "info": "Passend zum Farbschema: auf hell die Fassung mit dunkler Schrift, auf dunkel die weiße." },
        { "type": "text", "id": "logo_asset", "label": "Standard-Logo im Theme" },
        { "type": "number", "id": "logo_width", "label": "Breite der Standarddatei (px)", "default": 400 },
        { "type": "number", "id": "logo_height", "label": "Höhe der Standarddatei (px)", "default": 50 },
        { "type": "text", "id": "logo_alt", "label": "Alternativtext des Logos" },
        { "type": "header", "content": "Inhalt" },
        { "type": "text", "id": "heading", "label": "Aussage", "default": "Aussage des Abschnitts" },
        { "type": "image_picker", "id": "image", "label": "Bild (3:2)" },
        { "type": "text", "id": "image_asset", "label": "Standard-Bilddatei im Theme", "info": "1200 × 800 px" },
        { "type": "text", "id": "image_alt", "label": "Bildbeschreibung" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "label_1", "label": "Button 1 (Hauptaktion)" },
        { "type": "url", "id": "url_1", "label": "Link 1" },
        { "type": "text", "id": "label_2", "label": "Button 2" },
        { "type": "url", "id": "url_2", "label": "Link 2", "info": "Links auf andere Websites öffnen in einem neuen Fenster und bekommen einen Pfeil." },
        { "type": "text", "id": "advice_heading", "label": "Überschrift Beratung" },
        { "type": "richtext", "id": "advice_text", "label": "Text Beratung" },
        { "type": "header", "content": "Fußnote" },
        { "type": "text", "id": "footnote_term", "label": "Begriff mit Sternchen", "info": "Bekommt im Text ein Sternchen, sobald eine Fußnote eingetragen ist." },
        { "type": "text", "id": "footnote", "label": "Fußnote" },
        { "type": "header", "content": "Rechte Spalte" },
        {
          "type": "select",
          "id": "aside",
          "label": "Inhalt",
          "options": [
            { "value": "contact", "label": "Kontakt-Box des Shops" },
            { "value": "person", "label": "Ansprechpartner" },
            { "value": "none", "label": "Nichts" }
          ],
          "default": "contact"
        },
        { "type": "text", "id": "contact_title", "label": "Titel der Kontakt-Box", "default": "Angebot anfragen" },
        {
          "type": "select",
          "id": "topic",
          "label": "Voreingestelltes Thema der Kontakt-Box",
          "options": [
            { "value": "finanzierung", "label": "Finanzierung" },
            { "value": "versicherung", "label": "Versicherung" },
            { "value": "inzahlungnahme", "label": "Inzahlungnahme" },
            { "value": "probefahrt", "label": "Probefahrt" },
            { "value": "frage", "label": "Frage" }
          ],
          "default": "finanzierung"
        },
        { "type": "image_picker", "id": "person_image", "label": "Porträt Ansprechpartner (4:5)" },
        { "type": "text", "id": "person_image_asset", "label": "Standard-Porträt im Theme", "info": "720 × 900 px" },
        { "type": "text", "id": "person_image_alt", "label": "Bildbeschreibung Porträt" },
        { "type": "text", "id": "person_name", "label": "Name" },
        { "type": "text", "id": "person_company", "label": "Firma" },
        { "type": "textarea", "id": "person_address", "label": "Adresse (eine Zeile pro Adresszeile)" },
        { "type": "text", "id": "person_phone", "label": "Telefon" },
        { "type": "text", "id": "person_mobile", "label": "Mobil" }
      ]
    },
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "date", "label": "Datum (JJJJ-MM-TT)", "default": "2026-10-11" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Saisonabschluss-Ausfahrt" },
        { "type": "text", "id": "place", "label": "Ort und Uhrzeit", "default": "Start: Power Shop, 10:00 Uhr" },
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "image_asset", "label": "Standard-Bilddatei im Theme", "default": "event-1.jpg" }
      ]
    },
    {
      "type": "location",
      "name": "Standort",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "chip", "label": "Text im Menü", "default": "Standort & Kontakt" },
        { "type": "text", "id": "anchor", "label": "Anker (ohne #)", "default": "standort" },
        { "type": "text", "id": "title", "label": "Überschrift", "default": "Besuch uns im Power Shop" },
        { "type": "text", "id": "contact_title", "label": "Titel der Kontakt-Box", "default": "Schreib uns" }
      ]
    }
  ]
}
{% endschema %}
