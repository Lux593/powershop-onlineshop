{%- liquid
  assign threshold_cents = settings.free_shipping_threshold | default: 0 | times: 100
  assign threshold_text = threshold_cents | money_without_trailing_zeros
  assign return_days = settings.return_days | default: 0

  comment
    Ein Hinweis mit {schwelle} oder {tage} erscheint nur, wenn der Wert in den Theme-Einstellungen größer als 0 ist:
    sonst stünde „Versandkostenfrei ab 0 €“ oder „ Tage Rückgabe“ im Shop. Ein Hinweis ganz ohne Text und Link entfällt
    ebenfalls, ohne sichtbaren Hinweis die ganze Leiste.
  endcomment
  assign shown = 0
-%}

{%- capture announce_items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign skip = false
      if block.settings.text contains '{schwelle}' and threshold_cents <= 0
        assign skip = true
      endif
      if block.settings.text contains '{tage}' and return_days <= 0
        assign skip = true
      endif
      if block.settings.text == blank and block.settings.link_label == blank
        assign skip = true
      endif
      assign message = block.settings.text | replace: '{schwelle}', threshold_text | replace: '{tage}', return_days
    -%}
    {%- if skip == false -%}
      <span {{ block.shopify_attributes }}{% if block.settings.hide_on_mobile %} class="announce__extra"{% endif %}>
        {%- if shown > 0 %} · {% endif -%}
        {{- message -}}
        {%- if block.settings.link_label != blank and block.settings.link_url != blank %} <a href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>{% endif -%}
      </span>
      {%- assign shown = shown | plus: 1 -%}
    {%- elsif request.design_mode -%}
      <span {{ block.shopify_attributes }} hidden></span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <div class="announce" role="region" aria-label="Aktuelle Hinweise" data-section-id="{{ section.id }}">
    <div class="container announce__inner">
      <p>{{ announce_items }}</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ankündigungsleiste",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Hinweis",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "{schwelle} wird durch die Gratisversand-Grenze ersetzt, {tage} durch die Rückgabefrist.",
          "default": "Versandkostenfrei ab {schwelle}*"
        },
        { "type": "text", "id": "link_label", "label": "Link-Text" },
        { "type": "url", "id": "link_url", "label": "Link" },
        { "type": "checkbox", "id": "hide_on_mobile", "label": "Auf dem Handy ausblenden", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ankündigungsleiste",
      "blocks": [
        { "type": "message" },
        { "type": "message", "settings": { "text": "{tage} Tage Rückgabe", "hide_on_mobile": true } },
        { "type": "message", "settings": { "text": "", "link_label": "Probefahrt anfragen" } }
      ]
    }
  ]
}
{% endschema %}
