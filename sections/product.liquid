{%- liquid
  # Art der Produktseite: Motorrad, Teil oder Bekleidung/Accessoire
  assign kind = 'apparel'
  if product.type == 'Motorrad' or product.template_suffix == 'motorrad'
    assign kind = 'bike'
  elsif product.metafields.part.teilenummer.value != blank or product.template_suffix == 'teil'
    assign kind = 'part'
  endif

  # Nur auf Anfrage (snippets/on-request.liquid): Lager- und Lieferzeit-Zeilen versprechen dann nichts, das klärt die Anfrage
  capture pdp_on_request
    render 'on-request', product: product
  endcapture
  assign pdp_on_request = pdp_on_request | strip
  # Betreff der Anfrage in der Kontakt-Box unten: Titel, gewählte Ausführung, Artikelnummer (Teilenummer, sonst SKU)
  # Die SKU nur, wenn sie eindeutig ist (eine Variante oder eine gewählt): sonst stünde z. B. die Größe L im Betreff, ohne dass
  # jemand L gewählt hat
  assign request_subject = product.title
  assign request_sku = ''
  if product.has_only_default_variant
    assign request_sku = product.variants.first.sku
  elsif product.selected_variant != blank
    assign request_subject = request_subject | append: ' – ' | append: product.selected_variant.title
    assign request_sku = product.selected_variant.sku
  endif
  assign request_no = product.metafields.part.teilenummer.value | default: request_sku
  if request_no != blank
    assign request_subject = request_subject | append: ' (Art.-Nr. ' | append: request_no | append: ')'
  endif

  assign current_variant = product.selected_variant
  if current_variant == blank
    assign current_variant = product.selected_or_first_available_variant
  endif

  # Kategorie des Produkts: die genaueste Kategorie-Kollektion (wenigste Artikel). Zuerst Kategorien mit Präfix
  # (teile-, herren-, damen-, kinder-, motorraeder-), dann andere Kollektionen, zuletzt Linien (Willie G Skull u. a.).
  # Sammel-Kollektionen wie „Neuheiten“ (enthält fast alles) zählen nie. Neue Kategorien greifen so von selbst.
  # Quelle der Schiene „Ähnliche Artikel“ und der Brotkrumen (wenn man nicht über eine Kategorie kam).
  assign generic_handles = 'all,frontpage,neuheiten,sale,teile,herren,damen,kinder,accessoires,motorraeder,motorraeder-neu,motorraeder-gebraucht,motorraeder-vorfuehrer,geschenkgutscheine' | split: ','
  assign line_handles = 'willie-g-skull,factory-racing,dickies,realtree,power-shop-kollektion,ride-bells,poker-chips' | split: ','
  assign category = blank
  for pass in (1..3)
    for c in product.collections
      if generic_handles contains c.handle or c.products_count < 2
        continue
      endif
      assign c_prefix = c.handle | split: '-' | first
      assign c_pass = 2
      if line_handles contains c.handle
        assign c_pass = 3
      elsif c_prefix != c.handle
        if c_prefix == 'teile' or c_prefix == 'herren' or c_prefix == 'damen' or c_prefix == 'kinder' or c_prefix == 'motorraeder'
          assign c_pass = 1
        endif
      endif
      if c_pass == pass
        if category == blank or c.products_count < category.products_count
          assign category = c
        endif
      endif
    endfor
    if category != blank
      break
    endif
  endfor
  if category == blank
    assign category = product.collections.first
  endif

  # Brotkrumen: die Kollektion, über die man kam, sonst die Kategorie; davor die Hauptkategorie (Teile & Zubehör, Herren …)
  assign parent_collection = collection
  if parent_collection == blank or generic_handles contains parent_collection.handle
    assign parent_collection = category
  endif
  assign crumb_parent = blank
  if parent_collection != blank
    assign crumb_prefix = parent_collection.handle | split: '-' | first
    if crumb_prefix != parent_collection.handle and collections[crumb_prefix].title != blank
      assign crumb_parent = collections[crumb_prefix]
    endif
  endif

  assign is_new = false
  if product.tags contains 'neu'
    assign is_new = true
  endif
  assign is_sale = false
  if product.compare_at_price > product.price
    assign is_sale = true
  endif
-%}

{%- comment -%}
  App-Blöcke (Bewertungen, Empfehlungen u. a. aus dem Theme-Editor) gelten für alle drei Produktarten. Bei Bekleidung stehen sie im Abschnitt Bewertungen,
  bei Teilen und Motorrädern in einem eigenen Abschnitt vor den ähnlichen Produkten; ohne App-Block entsteht dort nichts.
{%- endcomment -%}
{%- capture app_blocks_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture badges_html -%}
  {%- if is_new -%}<span class="badge">Neu</span>{%- endif -%}
  {%- if is_sale -%}<span class="badge badge--sale">Sale</span>{%- endif -%}
{%- endcapture -%}

{%- capture breadcrumb_html -%}
  <nav class="breadcrumb" aria-label="Brotkrumen">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if crumb_parent != blank -%}
        <li><a href="{{ crumb_parent.url }}">{{ crumb_parent.title | escape }}</a></li>
      {%- endif -%}
      {%- if parent_collection != blank -%}
        <li><a href="{{ parent_collection.url }}">{{ parent_collection.title | escape }}</a></li>
      {%- endif -%}
      {%- comment -%} Der Titel steht direkt darunter als Überschrift, im Pfad deshalb nur für Screenreader (aktuelle Seite) {%- endcomment -%}
      <li class="sr-only"><span aria-current="page">{{ product.title | escape }}</span></li>
    </ol>
  </nav>
{%- endcapture -%}

{%- comment -%} ===================== MOTORRAD ===================== {%- endcomment -%}
{%- if kind == 'bike' -%}
  {%- liquid
    assign zustand = product.metafields.bike.zustand.value | default: 'neu'
    assign status = product.metafields.bike.status.value
    assign year = product.metafields.bike.baujahr.value
    assign ez = product.metafields.bike.erstzulassung.value
    assign km = product.metafields.bike.km.value
    assign kw = product.metafields.bike.leistung_kw.value
    assign ps = product.metafields.bike.leistung_ps.value
    assign ccm = product.metafields.bike.hubraum_ccm.value
    assign color = product.metafields.bike.farbe.value
    assign family = product.metafields.bike.modellfamilie.value
    assign tax = product.metafields.bike.besteuerung.value
    assign from_price = product.metafields.bike.ab_preis.value
    assign fzg_nr = product.metafields.bike.fahrzeugnummer.value
    assign hu = product.metafields.bike.hu_bis.value
    assign owners = product.metafields.bike.vorbesitzer.value
    assign equipment = product.metafields.bike.ausstattung.value
    assign reserved_until = product.metafields.bike.reserviert_bis.value

    comment
      Ausführungen (z. B. Farbe, Räder) als Varianten: Die gewählte Farbe ersetzt das Metafeld, Preis und Anfrage folgen der Variante.
    endcomment
    for option in product.options_with_values
      assign option_key = option.name | downcase
      if option_key == 'farbe' or option_key == 'color'
        assign color = current_variant.options[forloop.index0] | default: color
      endif
    endfor

    assign is_new_bike = false
    if zustand == 'neu'
      assign is_new_bike = true
    endif
    comment
      Ohne Kilometerstand: Neufahrzeuge zeigen 0 km, Gebrauchte „auf Anfrage“ (nicht „0 km“ als Tatsache).
    endcomment
    assign km_known = true
    if km == blank
      if is_new_bike
        assign km = 0
      else
        assign km_known = false
      endif
    endif
    assign is_reserved = false
    if status == 'reserviert'
      assign is_reserved = true
    endif
    assign can_reserve = false
    if is_new_bike == false and is_reserved == false
      assign can_reserve = true
    endif

    comment
      Betreff der Anfrage: „Titel (Ausführung, Modelljahr …, Fzg.-Nr. …)“. Fehlende Angaben entfallen samt Trenner,
      es bleibt nie „Modelljahr , Fzg.-Nr.“ oder „()“ stehen: Jede Angabe kommt mit „, “ davor, das erste „, “ fällt am Ende weg.
    endcomment
    assign label_parts = ''
    unless product.has_only_default_variant
      assign label_parts = ', ' | append: current_variant.title
    endunless
    if is_new_bike and year != blank
      assign label_parts = label_parts | append: ', Modelljahr ' | append: year
    elsif is_new_bike == false and ez != blank
      assign label_parts = label_parts | append: ', EZ ' | append: ez
    endif
    if from_price != true and fzg_nr != blank
      assign label_parts = label_parts | append: ', Fzg.-Nr. ' | append: fzg_nr
    endif
    assign label_parts = label_parts | remove_first: ', '
    assign bike_label = product.title
    if label_parts != blank
      assign bike_label = bike_label | append: ' (' | append: label_parts | append: ')'
    endif

    assign bike_topics = 'kauf,probefahrt,finanzierung,inzahlungnahme'
    if can_reserve
      assign bike_topics = bike_topics | append: ',reservierung'
    endif
    assign bike_topics = bike_topics | append: ',frage'
    assign similar = category.products
  -%}

  <div data-pdp="bike" data-section-id="{{ section.id }}">
    <div class="container">
      <div class="pdp__crumbs">{{ breadcrumb_html }}</div>
      <div class="pdp pdp--bike">
        <div class="pdp__media">
          {%- comment -%}
            Kein Zustands-Badge über den Fotos: Der Zustand steht im Titel, „Reserviert“ im Hinweis unter den Fakten.
            Die Bike-Karten behalten ihr Badge (snippets/bike-card.liquid).
          {%- endcomment -%}
          {% render 'pdp-gallery', product: product, wide: true %}
        </div>
        <div class="pdp__info" data-stagger="60">
          <h1 class="pdp__title">{{ product.title | escape }}</h1>
          {%- if family != blank or fzg_nr != blank -%}
            <p class="pdp__meta">
              {%- if family != blank -%}<span>{{ family | escape }}</span>{%- endif -%}
              {%- if fzg_nr != blank -%}<span>{% if from_price %}Modell {{ fzg_nr | escape }}{% else %}Fzg.-Nr. {{ fzg_nr | escape }}{% endif %}</span>{%- endif -%}
            </p>
          {%- endif -%}
          <div class="bike-price" data-pdp-dynamic="bike-price">
            <strong>{% if from_price %}ab {% endif %}{{ current_variant.price | money_without_trailing_zeros }}</strong>
            <p>
              {%- if from_price %}Ab-Preis laut Harley-Davidson · {% elsif is_new_bike %}Gesamtpreis inkl. Überführung und Nebenkosten · {% endif -%}
              {%- if tax == '25a' %}MwSt. nicht ausweisbar (Differenzbesteuerung § 25a UStG){% else %}inkl. 19 % MwSt.{% endif -%}
              {%- if is_new_bike == false and from_price != true %} · zzgl. Zulassung{% endif -%}
            </p>
          </div>

          {%- unless product.has_only_default_variant -%}
            <div class="bike-options">{% render 'pdp-options', product: product, variant: current_variant %}</div>
          {%- endunless -%}

          <dl class="bike-facts" data-pdp-dynamic="bike-facts">
            <div><dt>{% render 'icon', name: 'calendar' %}{% if is_new_bike %}Modelljahr{% else %}Erstzulassung{% endif %}</dt><dd>{% if is_new_bike %}{{ year | default: 'auf Anfrage' }}{% else %}{{ ez | default: 'auf Anfrage' }}{% endif %}</dd></div>
            <div><dt>{% render 'icon', name: 'gauge' %}km-Stand</dt><dd>{% if km_known %}{% render 'number-de', value: km %} km{% else %}auf Anfrage{% endif %}</dd></div>
            <div><dt>{% render 'icon', name: 'zap' %}Leistung</dt><dd>{% if kw != blank %}{{ kw }} kW ({{ ps }} PS){% else %}auf Anfrage{% endif %}</dd></div>
            <div><dt>{% render 'icon', name: 'cog' %}Hubraum</dt><dd>{% if ccm != blank %}{% render 'number-de', value: ccm %} cm³{% else %}auf Anfrage{% endif %}</dd></div>
            <div><dt>{% render 'icon', name: 'palette' %}Farbe</dt><dd>{{ color | default: '–' | escape }}</dd></div>
            <div><dt>{% render 'icon', name: 'shield-check' %}HU bis</dt><dd>{% if is_new_bike %}neu{% else %}{{ hu | default: '–' | escape }}{% endif %}</dd></div>
          </dl>

          {%- if is_reserved -%}
            <div class="reserved-banner">
              {% render 'icon', name: 'clock' %}
              <span><strong>Reserviert{% if reserved_until != blank %} bis {{ reserved_until | escape }}{% endif %}.</strong> Du kannst uns trotzdem kontaktieren – wir melden uns, falls das Bike wieder frei wird.</span>
            </div>
          {%- endif -%}

          {%- comment -%} Wie bei Artikeln auf Anfrage: ein Button, der zur Kontakt-Box springt und dort „Kaufanfrage“ wählt (assets/product.js) {%- endcomment -%}
          <div class="pdp__buy pdp__buy--request">
            <a class="btn btn--primary btn--block" href="#kontakt" data-contact-topic="kauf">{% render 'icon', name: 'message-circle' %}Jetzt anfragen</a>
          </div>
        </div>

        <div class="pdp-sections">
          {%- if equipment.size > 0 -%}
            {%- capture equip_body -%}
              <ul class="equip">{%- for item in equipment -%}<li>{% render 'icon', name: 'check' %}{{ item | escape }}</li>{%- endfor -%}</ul>
            {%- endcapture -%}
            {% render 'accordion', title: 'Ausstattung & Extras', body: equip_body %}
          {%- endif -%}

          {%- capture spec_body -%}
            <table class="spec-table" data-pdp-dynamic="bike-specs"><tbody>
              <tr><th>Modellfamilie</th><td>{{ family | default: '–' | escape }}</td></tr>
              <tr><th>Modell</th><td>{{ product.title | escape }}</td></tr>
              <tr><th>Modelljahr</th><td>{{ year | default: '–' }}</td></tr>
              <tr><th>Hubraum</th><td>{% if ccm != blank %}{% render 'number-de', value: ccm %} cm³{% else %}auf Anfrage{% endif %}</td></tr>
              <tr><th>Leistung</th><td>{% if kw != blank %}{{ kw }} kW ({{ ps }} PS){% else %}auf Anfrage{% endif %}</td></tr>
              <tr><th>Farbe</th><td>{{ color | default: '–' | escape }}</td></tr>
              <tr><th>{% if from_price %}Modellcode{% else %}Fahrzeugnummer{% endif %}</th><td>{{ fzg_nr | default: '–' | escape }}</td></tr>
            </tbody></table>
          {%- endcapture -%}
          {% render 'accordion', title: 'Technische Daten', body: spec_body %}

          {%- capture history_body -%}
            {%- if is_new_bike -%}
              <p>Neufahrzeug mit voller Herstellergarantie.</p>
            {%- else -%}
              <ul>
                <li>{% if owners == 0 %}Vorführfahrzeug aus unserem Haus{% elsif owners != blank %}{{ owners }} Vorbesitzer{% else %}Vorbesitzer auf Anfrage{% endif %}</li>
                <li>Scheckheftgepflegt bei Harley-Davidson Vertragspartnern</li>
                <li>Unfallfrei laut Vorbesitzer</li>
                <li>Frische Inspektion vor Übergabe</li>
              </ul>
            {%- endif -%}
          {%- endcapture -%}
          {% render 'accordion', title: 'Fahrzeughistorie', body: history_body %}

          {%- capture finance_body -%}
            <p>Wir erstellen dir ein individuelles Finanzierungs- oder Leasingangebot – passend zu Anzahlung, Laufzeit und Schlussrate. Wähle in der Kontakt-Box „Finanzierung“ und schick uns deine Anfrage.</p>        {%- endcapture -%}
          {% render 'accordion', title: 'Finanzierung', body: finance_body %}

          {%- capture place_body -%}
            <p>Besichtigung und Probefahrt im Power Shop{% if settings.address != blank %}, {{ settings.address | escape | newline_to_br }}{% endif %}. Der Kaufvertrag wird bei uns vor Ort abgeschlossen. Zulassung und Überführung übernehmen wir auf Wunsch.</p>
          {%- endcapture -%}
          {% render 'accordion', title: 'Standort & Übergabe', body: place_body %}
        </div>

        <div class="pdp__contact">
            {%- capture reserve_note -%}
              {%- if can_reserve -%}
                <div class="reserve-note">
                  <strong>{% render 'icon', name: 'clock' %}Reservierung möglich</strong>
                  {%- if settings.reservation_hours > 0 and settings.reservation_fee > 0 -%}
                    <p>{{ settings.reservation_hours }} h Reservierung gegen {{ settings.reservation_fee | times: 100 | money_without_trailing_zeros }} Gebühr – wird beim Kauf angerechnet, sonst erstattet.</p>
                  {%- endif -%}
                  <ol>
                    <li>Wähle oben „Reservierung“ und schreib uns per WhatsApp oder E-Mail.</li>
                    <li>Wir prüfen die Verfügbarkeit und senden dir einen Zahlungslink.</li>
                    <li>Nach Zahlung ist das Bike für dich reserviert.</li>
                  </ol>
                </div>
              {%- endif -%}
            {%- endcapture -%}
            {% render 'contact-box', anchor: 'kontakt', title: 'Interesse an diesem Bike?', topics: bike_topics, subject: bike_label, primary: true, extra: reserve_note %}
        </div>
      </div>
      {%- liquid
        if tax == '25a'
          assign sticky_note = 'MwSt. nicht ausweisbar (§ 25a UStG)'
        else
          assign sticky_note = 'inkl. 19 % MwSt.'
        endif
      -%}
      {%- render 'pdp-sticky-buy', product: product, contact_anchor: 'kontakt', topic: 'kauf', note: sticky_note, from: from_price, short_price: true -%}

      {%- if app_blocks_html != blank -%}
        <section class="section--tight">{{ app_blocks_html }}</section>
      {%- endif -%}

      {%- if similar.size > 1 -%}
        <section class="section--tight">
          <div class="section-head" data-reveal>
            <h2>Ähnliche Bikes</h2>
            <div class="rail-nav">
              <button type="button" data-rail-prev="rail-bikes-{{ section.id }}" aria-label="Zurück">{% render 'icon', name: 'chevron-left' %}</button>
              <button type="button" data-rail-next="rail-bikes-{{ section.id }}" aria-label="Weiter">{% render 'icon', name: 'chevron-right' %}</button>
            </div>
          </div>
          <div class="rail showroom-rail" id="rail-bikes-{{ section.id }}" style="grid-auto-columns:minmax(280px, calc((100% - 48px) / 3))">
            {%- assign shown = 0 -%}
            {%- for item in similar -%}
              {%- if item.id != product.id and shown < 6 -%}
                {%- assign shown = shown | plus: 1 -%}
                {% render 'bike-card', product: item, reveal: true %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    </div>
  </div>

{%- comment -%} ===================== TEIL ===================== {%- endcomment -%}
{%- elsif kind == 'part' -%}
  {%- liquid
    assign part_no = product.metafields.part.teilenummer.value | default: current_variant.sku
    assign families = product.metafields.part.modellfamilien.value
    assign years = product.metafields.part.baujahre.value
    comment
      Baujahre: als Liste behandelt (wie in product-card.liquid) und nie roh ausgegeben (sonst „20172018…“).
      Mehrere Jahre als „erstes–letztes“, ein einzelnes Jahr oder ein Text unverändert.
    endcomment
    assign years_sorted = years | sort
    assign years_label = ''
    if years_sorted.size > 1
      assign years_label = years_sorted.first | append: '–' | append: years_sorted.last
    elsif years_sorted.size == 1
      assign years_label = years_sorted.first
    endif
    assign approval = product.metafields.part.zulassung.value
    assign compat = product.metafields.part.kompatibilitaet.value

    case approval
      when 'abe'
        assign approval_class = 'badge--abe'
        assign approval_icon = 'shield-check'
        assign approval_label = 'Mit ABE / EG-Genehmigung'
        assign approval_tip = 'Darf ohne Eintragung verbaut werden. Die ABE bzw. EG-Genehmigung liegt bei und muss mitgeführt werden.'
      when 'eintragung'
        assign approval_class = 'badge--eintragung'
        assign approval_icon = 'circle-alert'
        assign approval_label = 'Eintragungspflichtig'
        assign approval_tip = 'Nach dem Einbau ist eine Abnahme (z. B. TÜV/DEKRA) und Eintragung in die Fahrzeugpapiere nötig. Wir erledigen das auf Wunsch für dich.'
      when 'keine'
        assign approval_class = 'badge--keine'
        assign approval_icon = 'circle-alert'
        assign approval_label = 'Ohne Straßenzulassung'
        assign approval_tip = 'Nur für den Einsatz auf abgesperrten Strecken (Rennsport). Im öffentlichen Straßenverkehr nicht zulässig.'
      else
        assign approval_class = ''
    endcase
    assign similar = category.products
  -%}

  <div data-pdp="part" data-section-id="{{ section.id }}">
    <div class="container">
      <div class="pdp__crumbs">{{ breadcrumb_html }}</div>
      <div class="pdp">
        {% render 'pdp-gallery', product: product, badges: badges_html %}
        <div class="pdp__info" data-stagger="60">
          <h1 class="pdp__title">{{ product.title | escape }}</h1>
          <div class="pdp__meta">
            {%- if product.vendor != blank -%}
              <span>{{ product.vendor | escape }}{% if product.type != blank %} · {{ product.type | escape }}{% endif %}</span>
            {%- endif -%}
            {%- if part_no != blank -%}
              <span class="partno">Art.-Nr. <code data-partno>{{ part_no | escape }}</code>
                <button type="button" data-copy="{{ part_no | escape }}" aria-label="Teilenummer kopieren">{% render 'icon', name: 'copy', class: 'icon--sm' %}</button>
              </span>
            {%- endif -%}
            {% render 'rating', product: product %}
          </div>
          <div class="pdp__price">
            <div data-pdp-dynamic="price">{% render 'price', product: product, variant: product.selected_variant, long: true %}</div>
            <div data-pdp-dynamic="stock">
              {%- if pdp_on_request == 'true' -%}
                <p class="stock stock--order">Verfügbarkeit und Lieferzeit auf Anfrage</p>
              {%- elsif current_variant.available -%}
                {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity <= 0 -%}
                  <p class="stock stock--order">Lieferbar in 5–7 Werktagen</p>
                {%- else -%}
                  <p class="stock">Auf Lager{% if settings.delivery_time != blank %} – Lieferzeit {{ settings.delivery_time }}{% endif %}</p>
                {%- endif -%}
              {%- else -%}
                <p class="stock stock--order">Aktuell nicht lieferbar – frag uns nach dem Liefertermin.</p>
              {%- endif -%}
            </div>
          </div>

          {% render 'pdp-buy', product: product, contact_anchor: 'werkstatt-kontakt' %}
          {% render 'pdp-usp', on_request: pdp_on_request %}

          {%- liquid
            assign show_compat = false
            if families.size > 0 or compat.size > 0
              assign show_compat = true
            endif
            assign is_universal = false
            if years_label == '(universell)'
              assign is_universal = true
            endif
            assign can_check = false
            if compat.size > 0 or is_universal
              assign can_check = true
            endif
          -%}
          {%- if show_compat -%}
            <div class="compat" data-compat{% if is_universal %} data-compat-universal{% endif %}>
              {%- comment -%}
                Passt-Check (assets/product.js): Oben die Box „Passt das zu deinem Motorrad?“ mit „Jetzt prüfen“ (Fenster
                #passt-check, snippets/passt-check.liquid). Ist ein Motorrad gemerkt oder kommt man aus einer gefilterten Liste
                (Modellfamilie + Baujahr), ersetzt product.js die Box durch das Ergebnis. Universelle Teile („(universell)“ in
                part.baujahre) passen immer: dort erscheint die Box nur mit gemerktem Motorrad.
              {%- endcomment -%}
              {%- if can_check -%}
                <div class="compat__fit" data-compat-fit data-state="ask"{% if is_universal %} hidden{% endif %}>
                  <div class="compat__fit-head">
                    <span class="compat__fit-icon compat__fit-icon--ask">{% render 'icon', name: 'motorbike' %}</span>
                    <span class="compat__fit-icon compat__fit-icon--ok">{% render 'icon', name: 'circle-check' %}</span>
                    <span class="compat__fit-icon compat__fit-icon--no">{% render 'icon', name: 'circle-alert' %}</span>
                    <strong data-compat-fit-title>Passt das zu deinem Motorrad?</strong>
                  </div>
                  <p class="compat__fit-lead" data-compat-fit-lead>Wähle Baujahr und Modell, wir prüfen es mit der Modellliste von Harley-Davidson.</p>
                  <div class="compat__fit-bikes" data-compat-fit-bikes></div>
                  <p data-compat-fit-text hidden></p>
                  <button class="btn btn--secondary btn--sm compat__fit-btn" type="button" data-open="passt-check" data-pc-open>Jetzt prüfen</button>
                </div>
              {%- endif -%}
              {%- if is_universal -%}
                <div class="compat__head">
                  <div class="compat__title">{% render 'icon', name: 'badge-check' %}<strong>Passt für alle Modelle</strong></div>
                </div>
                <p class="compat__note">Universell einsetzbar · Angaben laut Hersteller</p>
              {%- elsif compat.size > 0 -%}
                {%- comment -%} Familien und Modelle alphabetisch (sort_natural: ohne Rücksicht auf Groß- und Kleinschreibung) {%- endcomment -%}
                {%- assign fam_list = compat | map: 'family' | uniq | sort_natural -%}
                <details>
                  <summary>
                    <span class="compat__sum">
                      {% render 'icon', name: 'list' %}
                      <span><strong>Alle kompatiblen Modelle anzeigen</strong><small>{{ compat.size }} kompatible {% if compat.size == 1 %}Modell{% else %}Modelle{% endif %}</small></span>
                    </span>
                    {%- render 'icon', name: 'chevron-down', class: 'icon--sm' -%}
                  </summary>
                  <div class="compat__table">
                    <label class="sr-only" for="compat-q">Modell suchen</label>
                    <input class="input" id="compat-q" type="search" placeholder="Modell suchen, z. B. Street Glide" data-compat-q>
                    <div class="compat__scroll" data-lenis-prevent>
                      <table data-compat-rows>
                        <thead><tr><th scope="col">Modell</th><th scope="col">Baujahre</th></tr></thead>
                        {%- for fam in fam_list -%}
                          {%- assign fam_rows = compat | where: 'family', fam | sort_natural: 'model' -%}
                          <tbody data-group="{{ fam | escape }}">
                            <tr class="compat__group"><th scope="rowgroup" colspan="2">{{ fam | escape }}</th></tr>
                            {%- for row in fam_rows -%}
                              <tr data-family="{{ row.family | escape }}" data-code="{{ row.code | escape }}" data-from="{{ row.from }}" data-to="{{ row.to }}"><td>{{ row.model | escape }}</td><td>{{ row.from }}{% if row.to != row.from %}–{{ row.to }}{% endif %}</td></tr>
                            {%- endfor -%}
                          </tbody>
                        {%- endfor -%}
                      </table>
                    </div>
                    {%- comment -%} Leere Suche: Die Liste enthält nur passende Modelle. Wer sein Modell hier nicht findet, soll nicht denken, es fehle im Shop {%- endcomment -%}
                    <p class="small muted" data-compat-empty hidden>Nicht in der Liste? Dann passt das Teil laut Hersteller nicht zu diesem Modell. <button class="text-link" type="button" data-open="passt-check" data-pc-open>Motorrad genau prüfen</button> oder <a class="text-link" href="#werkstatt-kontakt" data-contact-topic="kompatibilitaet">frag unsere Werkstatt</a>.</p>
                  </div>
                </details>
              {%- elsif families.size > 0 -%}
                <div class="compat__head">
                  <div class="compat__title">{% render 'icon', name: 'badge-check' %}<strong>Passt für</strong></div>
                </div>
                <p class="compat__note">{{ families | join: ', ' | escape }}{% if years_label != blank %} · {{ years_label | escape }}{% endif %} · Angaben laut Hersteller</p>
              {%- endif -%}
              <div class="compat__foot">
                {% render 'icon', name: 'wrench' %}
                <div>Einbau durch Fachwerkstatt empfohlen. <a class="text-link" href="#werkstatt-kontakt" data-contact-topic="einbau">Werkstatt-Termin anfragen</a></div>
              </div>
            </div>
            {%- if can_check -%}{% render 'passt-check' %}{%- endif -%}
          {%- endif -%}

          {%- if approval_class != blank -%}
            <div class="approval">
              <span class="badge {{ approval_class }}">{% render 'icon', name: approval_icon %}{{ approval_label }}</span>
              <span class="tip">
                <button class="tip__btn" type="button" aria-describedby="tip-approval" aria-label="Was bedeutet das?">{% render 'icon', name: 'info' %}</button>
                <span class="tip__bubble" role="tooltip" id="tip-approval">{{ approval_tip }}</span>
              </span>
            </div>
          {%- endif -%}

          {%- unless show_compat -%}
            <div class="note">
              {% render 'icon', name: 'wrench' %}
              <div>Einbau durch Fachwerkstatt empfohlen. <a class="text-link" href="#werkstatt-kontakt" data-contact-topic="einbau">Werkstatt-Termin anfragen</a></div>
            </div>
          {%- endunless -%}

          <div>
            {% render 'product-description', product: product %}
            {%- capture spec_body -%}
              <table class="spec-table"><tbody>
                {%- if part_no != blank -%}<tr><th>Art.-Nr.</th><td>{{ part_no | escape }}</td></tr>{%- endif -%}
                <tr><th>Marke</th><td>{{ product.vendor | escape }}</td></tr>
                {%- if product.metafields.part.material.value != blank -%}<tr><th>Material</th><td>{{ product.metafields.part.material.value | escape }}</td></tr>{%- endif -%}
                <tr><th>Zulassung</th><td>{{ approval_label | default: 'Keine Zulassung nötig' }}</td></tr>
              </tbody></table>
            {%- endcapture -%}
            {% render 'accordion', title: 'Technische Daten', body: spec_body %}

            {%- capture scope_body -%}
              <ul><li>1 × {{ product.title | escape }}</li><li>Montagematerial</li>{% if approval == 'abe' %}<li>ABE / EG-Genehmigung</li>{% endif %}</ul>
            {%- endcapture -%}
            {% render 'accordion', title: 'Lieferumfang', body: scope_body %}
            {% render 'pdp-gpsr', product: product %}
            {%- capture ship_body -%}
              {% render 'pdp-shipping' %}
            {%- endcapture -%}
            {% render 'accordion', title: 'Versand', body: ship_body %}
          </div>
        </div>
      </div>

      {%- if app_blocks_html != blank -%}
        <section class="section--tight">{{ app_blocks_html }}</section>
      {%- endif -%}

      {% render 'product-rail', product: product, similar: similar, heading: 'Ähnliche Artikel', families: families, section_id: section.id %}

      <section class="section--tight">
        <div style="max-width:560px">
          {%- comment -%}
            Artikel nur auf Anfrage: Die Box ist zugleich die Anfrage, „Artikel anfragen“ ist das erste und gewählte Thema. „Jetzt
            anfragen“ im Kaufbereich und in der mobilen Kaufleiste springt hierher (keine zweite Reihe Buttons oben).
          {%- endcomment -%}
          {%- if pdp_on_request == 'true' -%}
            {% render 'contact-box', anchor: 'werkstatt-kontakt', title: 'Artikel anfragen', intro: 'Wir klären Verfügbarkeit, Lieferzeit, Passform und Einbau mit dir. Wähle dein Anliegen, die Nachricht ist vorausgefüllt.', topics: 'anfrage,kompatibilitaet,einbau,frage', subject: request_subject, ref: '' %}
          {%- else -%}
            {% render 'contact-box', anchor: 'werkstatt-kontakt', title: 'Fragen zum Einbau?', intro: 'Unsere Werkstatt hilft dir bei Kompatibilität, Einbau und Eintragung.', topics: 'kompatibilitaet,einbau,frage', subject: product.title, ref: '' %}
          {%- endif -%}
        </div>
      </section>
    </div>
    {%- render 'pdp-sticky-buy', product: product, contact_anchor: 'werkstatt-kontakt' -%}
  </div>

{%- comment -%} ===================== BEKLEIDUNG / ACCESSOIRES ===================== {%- endcomment -%}
{%- else -%}
  {%- liquid
    assign size_type = product.metafields.apparel.groessentabelle.value
    assign sku = current_variant.sku
    assign similar = category.products
  -%}

  <div data-pdp="apparel" data-section-id="{{ section.id }}">
    <div class="container">
      <div class="pdp__crumbs">{{ breadcrumb_html }}</div>
      <div class="pdp">
        {% render 'pdp-gallery', product: product, badges: badges_html %}
        <div class="pdp__info" data-stagger="60">
          <h1 class="pdp__title">{{ product.title | escape }}</h1>
          <div class="pdp__meta">
            {%- if product.vendor != blank or product.type != blank -%}
              <span>{{ product.vendor | escape }}{% if product.vendor != blank and product.type != blank %} · {% endif %}{{ product.type | escape }}</span>
            {%- endif -%}
            <span data-pdp-dynamic="sku">{%- if sku != blank -%}<span class="partno">Art.-Nr. {{ sku | escape }}</span>{%- endif -%}</span>
            {% render 'rating', product: product %}
            <a class="text-link small" href="#bewertungen">Bewertungen lesen</a>
          </div>
          <div class="pdp__price" data-pdp-dynamic="price">{% render 'price', product: product, variant: product.selected_variant, long: true %}</div>

          {% render 'pdp-buy', product: product, size_type: size_type, contact_anchor: 'artikel-kontakt' %}
          {% render 'pdp-usp', on_request: pdp_on_request %}

          <div>
            {% render 'product-description', product: product %}
            {%- if product.metafields.apparel.material.value != blank -%}
              {%- capture material_body -%}
                <p>{{ product.metafields.apparel.material.value | escape }}</p>
                <p>Pflege: Siehe Etikett. Leder mit geeigneter Lederpflege behandeln, nicht in den Trockner.</p>
              {%- endcapture -%}
              {% render 'accordion', title: 'Material & Pflege', body: material_body %}
            {%- endif -%}
            {%- if size_type != blank -%}
              {%- capture fit_body -%}
                {%- if product.metafields.apparel.passform.value != blank -%}<p>{{ product.metafields.apparel.passform.value | escape }}</p>{%- endif -%}
                <p>Unsicher? Wirf einen Blick in die <button class="text-link" type="button" data-open="sizeguide" data-type="{{ size_type }}">Größentabelle</button>.</p>
              {%- endcapture -%}
              {% render 'accordion', title: 'Passform', body: fit_body %}
            {%- endif -%}
            {%- capture ship_body -%}
              {% render 'pdp-shipping', apparel: true %}
            {%- endcapture -%}
            {% render 'accordion', title: 'Versand & Rückgabe', body: ship_body %}
            {% render 'pdp-gpsr', product: product %}
          </div>
        </div>
      </div>

      <section class="section--tight" id="bewertungen">
        <div class="section-head"><h2>Bewertungen</h2>{% render 'rating', product: product %}</div>
        {{ app_blocks_html }}
        <div class="note">
          {% render 'icon', name: 'badge-check' %}
          <div><strong>Geprüfte Bewertungen</strong><br>Bewertungen stammen nur von Kund:innen, die das Produkt bei uns gekauft haben (Pflichthinweis nach UWG).</div>
        </div>
      </section>

      {% render 'product-rail', product: product, similar: similar, heading: 'Das könnte dir auch gefallen', section_id: section.id %}

      {%- if pdp_on_request == 'true' -%}
        {%- comment -%} Bekleidung nur auf Anfrage: die Anfrage-Box, zu der „Jetzt anfragen“ oben und in der Kaufleiste springt {%- endcomment -%}
        <section class="section--tight">
          <div style="max-width:560px">
            {% render 'contact-box', anchor: 'artikel-kontakt', title: 'Artikel anfragen', intro: 'Wir klären Verfügbarkeit, Lieferzeit und Größe mit dir. Die Nachricht ist vorausgefüllt.', topics: 'anfrage,frage', subject: request_subject, ref: '' %}
          </div>
        </section>
      {%- endif -%}
    </div>
    {%- render 'pdp-sticky-buy', product: product, contact_anchor: 'artikel-kontakt' -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Produktseite",
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
