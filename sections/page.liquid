<section class="page-banner on-dark textured">
  <div class="container page-banner__inner">
    <div class="page-banner__text">
      <nav class="breadcrumb" aria-label="Brotkrumen">
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><span aria-current="page">{{ page.title | escape }}</span></li>
        </ol>
      </nav>
      <h1>{{ page.title | escape }}</h1>
    </div>
  </div>
</section>

{%- liquid
  # Seiten ohne eigenen Text (z. B. Kontakt, deren Inhalt aus Sektionen kommt) lassen keine leere Fläche stehen
  assign has_body = false
  assign body_text = page.content | strip_html | strip
  if body_text != blank or page.content contains '<img' or page.content contains '<iframe' or page.content contains '<video'
    assign has_body = true
  endif
-%}
{%- if has_body -%}
  <div class="container section--tight">
    <div class="page-content">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Seite",
  "settings": []
}
{% endschema %}
