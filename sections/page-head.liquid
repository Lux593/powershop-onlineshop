{%- comment -%}
  Seitenkopf mit Bild für Inhaltsseiten (Finanzierung, später weitere Seiten der alten Website).
  Gleiche Bühne wie der Kategorie-Kopf mit Film (.page-banner--film in assets/shop.css), nur mit Standbild:
  Text links, Bildfenster 4:3 rechts. Mit Bewegung ab 768 px „Tiefe“: das Fenster läuft langsamer, das Bild zoomt heraus,
  der Text zieht hoch und blendet aus (assets/pages.js setzt --film-depth). Mobil bleibt der Text kleben und das Bild
  schiebt sich dahinter (nur CSS). Darunter optional Partner-Logos (weiß) und Sprunglinks zu Abschnitten der Seite.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign has_logos = false
  assign has_jumps = false
  for block in section.blocks
    if block.type == 'logo'
      assign has_logos = true
    elsif block.type == 'jump' and block.settings.label != blank
      assign has_jumps = true
    endif
  endfor
-%}
{%- capture head_image -%}
  {%- render 'media', image: section.settings.image, asset: section.settings.image_asset, width: 960, height: 720, alt: section.settings.image_alt, class: 'film-banner__poster', fetchpriority: 'high', sizes: '(min-width: 768px) 448px, 100vw' -%}
{%- endcapture -%}
{%- assign head_image = head_image | strip -%}

<section
  class="page-banner on-dark textured page-banner--film page-head"
  aria-labelledby="page-head-title-{{ section.id }}"
  data-depth
  data-section-id="{{ section.id }}"
>
  <div class="container page-banner__inner">
    <div class="page-banner__text">
      <nav class="breadcrumb" aria-label="Brotkrumen">
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><span aria-current="page">{{ heading | escape }}</span></li>
        </ol>
      </nav>
      <h1 id="page-head-title-{{ section.id }}">{{ heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="film-banner__lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if has_jumps -%}
        <nav class="page-head__jumps chip-row" aria-label="Auf dieser Seite" data-stagger="70">
          {%- for block in section.blocks -%}
            {%- if block.type == 'jump' and block.settings.label != blank -%}
              <a class="chip" href="#{{ block.settings.anchor | default: block.id }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
      {%- if has_logos -%}
        <ul class="page-head__logos" role="list" aria-label="{{ section.settings.logos_label | escape }}" data-stagger="90">
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'media', image: block.settings.image, asset: block.settings.image_asset, width: block.settings.width, height: block.settings.height, alt: block.settings.alt -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- if head_image != blank -%}
      <div class="page-banner__media">
        <div class="film-banner__frame">{{ head_image }}</div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Seitenkopf mit Bild",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "info": "Leer = Titel der Seite" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Bild (4:3)" },
    { "type": "text", "id": "image_asset", "label": "Standardbild (Datei in assets/)", "default": "finanzierung-breakout.jpg", "info": "Gilt, solange kein Bild gewählt ist. 960 × 720 px." },
    { "type": "text", "id": "image_alt", "label": "Alternativtext des Bildes" },
    { "type": "text", "id": "logos_label", "label": "Bezeichnung der Logo-Reihe (für Screenreader)", "default": "Partner" }
  ],
  "blocks": [
    {
      "type": "jump",
      "name": "Sprunglink",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Beschriftung" },
        { "type": "text", "id": "anchor", "label": "Anker-ID des Ziels", "info": "Ohne #, z. B. finanzierung. Steht im Ziel-Abschnitt unter „Anker-ID“." }
      ]
    },
    {
      "type": "logo",
      "name": "Logo",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo (weiß, transparent)" },
        { "type": "text", "id": "image_asset", "label": "Standard-Logo (Datei in assets/)" },
        { "type": "number", "id": "width", "label": "Breite der Standarddatei (px)", "default": 400 },
        { "type": "number", "id": "height", "label": "Höhe der Standarddatei (px)", "default": 50 },
        { "type": "text", "id": "alt", "label": "Alternativtext" }
      ]
    }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
