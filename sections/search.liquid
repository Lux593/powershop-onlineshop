<div data-collection data-section-id="{{ section.id }}">
  <section class="page-banner on-dark textured">
    <div class="container page-banner__inner">
      <div class="page-banner__text">
        <nav class="breadcrumb" aria-label="Brotkrumen">
          <ol>
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><span aria-current="page">Suche</span></li>
          </ol>
        </nav>
        <h1>{% if search.performed %}Suche: „{{ search.terms | escape }}“{% else %}Suche{% endif %}</h1>
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-inline">
          <label class="sr-only" for="search-page-input">Suche nach Produkt, Modell oder Teilenummer</label>
          <input class="input" id="search-page-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Produkt, Modell oder Teilenummer" autocomplete="off">
          <button class="btn btn--primary" type="submit">{% render 'icon', name: 'search' %}Suchen</button>
        </form>
      </div>
      <div class="page-banner__media">
        {%- capture banner_html -%}
          {%- render 'media', image: section.settings.banner_image, asset: 'banner-neuheiten.jpg', width: 1200, height: 600, sizes: '50vw', loading: 'lazy' -%}
        {%- endcapture -%}
        {{- banner_html | replace: '<img', '<img fetchpriority="high"' -}}
      </div>
    </div>
  </section>

  <div class="container">
    {%- if search.performed -%}
      {%- comment -%} Sortierung und Spalten ergeben ohne Treffer keinen Sinn. Aktive Filter lassen die Leiste stehen, damit man sie lösen kann. {%- endcomment -%}
      {%- liquid
        assign show_toolbar = false
        if search.results_count > 0
          assign show_toolbar = true
        endif
        for filter in search.filters
          if filter.active_values.size > 0
            assign show_toolbar = true
          endif
        endfor
      -%}
      {%- if show_toolbar -%}
        {%- render 'results-toolbar', results: search, action: routes.search_url, terms: search.terms, default_cols: '4' -%}
      {%- endif -%}

      {%- paginate search.results by section.settings.per_page -%}
        <div data-results>
          {%- capture reset_link -%}{{ routes.search_url }}?q={{ search.terms | url_encode }}{%- endcapture -%}
          {%- render 'active-filters', results: search, reset_url: reset_link, singular: 'Treffer', plural: 'Treffer' -%}

          {%- if search.results_count > 0 -%}
            <h2 class="sr-only">Suchergebnisse</h2>
            <div class="product-grid" data-grid data-cols="4">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  {%- comment -%} Erstblick: eager und ohne Einblenden, damit das LCP-Bild nicht versteckt startet {%- endcomment -%}
                  {%- if forloop.index0 < 4 -%}
                    {% render 'result-card', product: item, loading: 'eager' %}
                  {%- else -%}
                    {% render 'result-card', product: item, reveal: true %}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- assign other_count = 0 -%}
            {%- for item in search.results -%}
              {%- unless item.object_type == 'product' -%}{%- assign other_count = other_count | plus: 1 -%}{%- endunless -%}
            {%- endfor -%}
            {%- if other_count > 0 -%}
              <h2 class="h3" style="margin-top:var(--s-6)">Weitere Treffer</h2>
              <ul class="search-other">
                {%- for item in search.results -%}
                  {%- unless item.object_type == 'product' -%}
                    <li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- else -%}
            {%- liquid
              assign has_channel = false
              if settings.phone != blank or settings.whatsapp != blank or settings.email != blank
                assign has_channel = true
              endif
              capture wa_text
                echo 'Hallo Power-Shop-Team, ich suche: ' | append: search.terms
              endcapture
              capture mail_subject
                echo 'Suche: ' | append: search.terms
              endcapture
            -%}
            <div class="empty">
              {% render 'icon', name: 'search', class: 'icon--lg' %}
              <h2 class="h3">Keine Treffer</h2>
              <p class="muted">Prüfe die Schreibweise, suche nach der Teilenummer{% if has_channel %} oder frag uns direkt{% else %} oder stöbere in den Kategorien{% endif %}.</p>
              <div class="chip-row">
                {%- for top_link in linklists['main-menu'].links limit: 5 -%}
                  <a class="chip" href="{{ top_link.url }}">{{ top_link.title }}</a>
                {%- endfor -%}
              </div>
              <div class="chip-row">
                {%- if settings.phone != blank -%}
                  <a class="btn btn--primary" href="tel:{{ settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '/' }}">{% render 'icon', name: 'phone' %}Anrufen</a>
                {%- endif -%}
                {%- if settings.whatsapp != blank -%}
                  <a class="btn btn--outline-dark" href="https://wa.me/{{ settings.whatsapp }}?text={{ wa_text | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'message-circle' %}WhatsApp</a>
                {%- endif -%}
                {%- if settings.email != blank -%}
                  <a class="btn btn--outline-dark" href="mailto:{{ settings.email }}?subject={{ mail_subject | url_encode }}">{% render 'icon', name: 'mail' %}E-Mail</a>
                {%- endif -%}
                <a class="btn btn--secondary" href="{{ routes.root_url }}">Zur Startseite</a>
              </div>
            </div>
          {%- endif -%}

          {%- render 'pagination', paginate: paginate -%}
        </div>
      {%- endpaginate -%}
    {%- else -%}
      <div class="empty">
        {% render 'icon', name: 'search', class: 'icon--lg' %}
        <h2 class="h3">Wonach suchst du?</h2>
        <p class="muted">Suche nach Produkt, Modell oder Teilenummer.</p>
      </div>
    {%- endif -%}
  </div>
  <div class="section--tight"></div>
</div>

{% schema %}
{
  "name": "Suche",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Treffer pro Seite", "min": 8, "max": 24, "step": 4, "default": 12 },
    { "type": "image_picker", "id": "banner_image", "label": "Bannerbild" }
  ]
}
{% endschema %}
