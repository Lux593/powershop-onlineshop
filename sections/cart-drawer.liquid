{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign total = cart.total_price
  assign missing = threshold | minus: total
  assign pct = 100
  if threshold > 0 and missing > 0
    assign pct = total | times: 100 | divided_by: threshold
  endif
  assign pct = pct | at_most: 100
-%}

{%- liquid
  # Kasse gesperrt, solange ein Artikel nur auf Anfrage im Warenkorb liegt (snippets/on-request.liquid). Der Button zur Kasse
  # wird dann gar nicht ausgegeben, nicht nur versteckt. Direkt-Links zur Kasse schließt das nicht (nur eine Sperr-App).
  assign cart_blocked = false
  for item in cart.items
    capture item_on_request
      render 'on-request', product: item.product
    endcapture
    assign item_on_request = item_on_request | strip
    if item_on_request == 'true'
      assign cart_blocked = true
      break
    endif
  endfor
-%}

<dialog class="drawer drawer--cart" id="cart-drawer" aria-labelledby="cart-title" data-cart-drawer data-lenis-prevent>
  <div class="drawer__head">
    <h2 class="h4 drawer__title" id="cart-title"><img class="drawer__hd" src="{{ 'hd-bar-shield.png' | asset_url }}" alt="" width="49" height="40">Warenkorb ({{ cart.item_count }})</h2>
    <button class="icon-btn" type="button" data-close aria-label="Warenkorb schließen">{% render 'icon', name: 'x' %}</button>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="drawer__body" data-lenis-prevent>
      <div class="drawer__empty">
        {% render 'icon', name: 'shopping-bag' %}
        <p>Dein Warenkorb ist noch leer.</p>
        <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Produkte entdecken</a>
      </div>
    </div>
  {%- else -%}
    <div class="drawer__body" data-lenis-prevent>
      {%- if threshold > 0 -%}
        <div class="progress">
          <span>
            {%- if missing > 0 -%}
              Noch <strong>{{ missing | money }}</strong> bis zum kostenlosen Versand
            {%- else -%}
              <strong>Glückwunsch!</strong> Dein Versand ist kostenlos.
            {%- endif -%}
          </span>
          <div class="progress__bar" role="progressbar" aria-label="Fortschritt bis zum kostenlosen Versand" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
            <span style="--p: {{ pct | divided_by: 100.0 }}"></span>
          </div>
        </div>
      {%- endif -%}

      {%- for item in cart.items -%}
        {% render 'cart-line', item: item, line: forloop.index %}
      {%- endfor -%}
    </div>

    <div class="drawer__foot on-dark">
      <div class="subtotal"><span>Zwischensumme</span><strong>{{ cart.total_price | money }}</strong></div>
      <p class="caption muted">
        inkl. MwSt., zzgl.
        {% if missing > 0 and settings.shipping_cost_text != blank %}{{ settings.shipping_cost_text }} {% endif -%}
        Versand{% if threshold > 0 and missing <= 0 %} (kostenlos){% endif %}
        {%- comment -%} Lieferzeit je Position (snippets/cart-line.liquid, delivery-info) {%- endcomment -%}
      </p>
{%- if cart_blocked -%}
        <p class="cart-blocked" role="alert">{% render 'icon', name: 'circle-alert' %}<span>Im Warenkorb liegt ein Artikel, den es nur auf Anfrage gibt. Frag ihn bei uns an oder entferne ihn, dann geht es zur Kasse.</span></p>
      {%- else -%}
      <form action="{{ routes.cart_url }}" method="post">
        <button class="btn btn--primary btn--block" type="submit" name="checkout">Zur Kasse {% render 'icon', name: 'arrow-right' %}</button>
      </form>
      {%- endif -%}
      <button class="btn btn--outline-light btn--block" type="button" data-close>Weiter einkaufen</button>
    </div>
  {%- endif -%}
</dialog>

{% schema %}
{
  "name": "Warenkorb-Drawer"
}
{% endschema %}
