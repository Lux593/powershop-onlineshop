{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign missing = threshold | minus: cart.total_price
-%}

<div class="container cart-page" data-cart-page data-section-id="{{ section.id }}">
  <nav class="breadcrumb" aria-label="Brotkrumen" style="padding-top:20px">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><span aria-current="page">Warenkorb</span></li>
    </ol>
  </nav>
  <h1 class="cart-page__title">Warenkorb{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h1>

  {%- liquid
  # Kasse gesperrt, solange ein Artikel nur auf Anfrage im Warenkorb liegt (snippets/on-request.liquid). Der Button zur Kasse
  # wird dann gar nicht ausgegeben, nicht nur versteckt. Direkt-Links zur Kasse schließt das nicht (nur eine Sperr-App).
  assign cart_blocked = false
  for item in cart.items
    capture item_on_request
      render 'on-request', product: item.product
    endcapture
    assign item_on_request = item_on_request | strip
    if item_on_request == 'true'
      assign cart_blocked = true
      break
    endif
  endfor

  # Versandklassen (snippets/shipping-class.liquid): Sperrgut oder Artikel nur zur Abholung im Warenkorb = an der Kasse nur Abholung
  assign cart_pickup = false
  assign cart_parcel = false
  for item in cart.items
    capture item_ship
      render 'shipping-class', product: item.product
    endcapture
    assign item_ship = item_ship | strip
    if item_ship == blank
      assign cart_parcel = true
    else
      assign cart_pickup = true
    endif
  endfor
-%}
{%- if cart.item_count == 0 -%}
    <div class="empty">
      {% render 'icon', name: 'shopping-bag', class: 'icon--lg' %}
      <h2 class="h3">Dein Warenkorb ist noch leer.</h2>
      <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Produkte entdecken</a>
    </div>
  {%- else -%}
    <div class="cart-page__grid">
      <div class="cart-page__lines">
        {%- for item in cart.items -%}
          {% render 'cart-line', item: item, line: forloop.index %}
        {%- endfor -%}
      </div>

      <aside class="cart-page__summary" aria-label="Zusammenfassung">
        <div class="subtotal"><span>Zwischensumme</span><strong>{{ cart.total_price | money }}</strong></div>
        {%- comment -%} Lieferzeit je Position (snippets/cart-line.liquid, delivery-info) {%- endcomment -%}
        <p class="caption muted">{% render 'cart-shipping-line', threshold: threshold, missing: missing, pickup: cart_pickup %}</p>
        {%- if cart_pickup -%}{% render 'cart-pickup-note', parcel: cart_parcel %}{%- endif -%}
{%- if cart_blocked -%}
          <p class="cart-blocked" role="alert">{% render 'icon', name: 'circle-alert' %}<span>Im Warenkorb liegt ein Artikel, den es nur auf Anfrage gibt. Frag ihn bei uns an oder entferne ihn, dann geht es zur Kasse.</span></p>
        {%- else -%}
        <form action="{{ routes.cart_url }}" method="post">
          <button class="btn btn--primary btn--block" type="submit" name="checkout">Zur Kasse {% render 'icon', name: 'arrow-right' %}</button>
        </form>
        {%- endif -%}
        <a class="btn btn--text" href="{{ routes.all_products_collection_url }}" style="justify-self:center">Weiter einkaufen</a>
        {% render 'payments', style: 'justify-content:center', light: true %}
      </aside>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Warenkorb",
  "settings": []
}
{% endschema %}
