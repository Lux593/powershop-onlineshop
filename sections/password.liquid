<section class="on-dark textured" style="min-height:100vh;display:grid;place-items:center;padding:var(--s-6) var(--gutter)">
  <div class="container" style="max-width:480px;display:grid;gap:20px;text-align:center">
    <span class="wordmark">Power<span>Shop</span></span>
    <h1>Bald geht’s los</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- else -%}
      <p>Der Shop wird gerade vorbereitet. Mit dem Passwort kommst du schon jetzt rein.</p>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p role="alert" style="color:var(--c-error-on-dark)">Das Passwort stimmt nicht. Bitte versuch es noch einmal.</p>
      {%- endif -%}
      <div class="field">
        <label class="sr-only" for="password-input">Passwort</label>
        <input class="input" type="password" name="password" id="password-input" placeholder="Passwort" autocomplete="current-password">
      </div>
      <button class="btn btn--primary btn--block" type="submit">Eintreten</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Passwortseite",
  "settings": []
}
{% endschema %}
