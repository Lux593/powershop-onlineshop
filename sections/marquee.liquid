{%- comment -%}
  Lauftext-Band direkt unter dem Hero. Ohne Bewegung (kein JS, Reduced-Motion, Theme-Editor) steht der Satz einmal
  zentriert und umbrechend da. Mit Bewegung läuft die Spur (data-marquee, assets/motion.js) und die Wiederholungen
  (.marquee__item--rep) füllen sie, damit sie auch auf breiten Bildschirmen nie Lücken zeigt. Die Wiederholungen und
  der Klon sind aria-hidden. Der Pause-Button ist Pflicht (WCAG 2.2.2) und erscheint nur, solange die Spur läuft.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- assign repeats = 12 | divided_by: section.blocks.size | at_least: 2 -%}
  <section
    class="marquee"
    {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | escape }}"{% endif %}
    aria-label="{{ section.settings.aria_label | escape }}"
    data-section-id="{{ section.id }}"
  >
    <div class="marquee__viewport">
      <div class="marquee__track" data-marquee="{{ section.settings.speed }}">
        <ul class="marquee__set">
          {%- for round in (1..repeats) -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <li
                  class="marquee__item{% if round > 1 %} marquee__item--rep{% endif %}{% if round == 1 and forloop.last %} marquee__item--last{% endif %}"
                  {% if round > 1 %}aria-hidden="true"{% else %}{{ block.shopify_attributes }}{% endif %}
                >{{ block.settings.text | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
    <button class="marquee__toggle" type="button" data-marquee-toggle aria-pressed="false" aria-label="Lauftext pausieren">
      {% render 'icon', name: 'pause', class: 'marquee__icon marquee__icon--pause' %}
      {% render 'icon', name: 'play', class: 'marquee__icon marquee__icon--play' %}
    </button>
  </section>
{%- elsif request.design_mode -%}
  <section class="marquee marquee--empty">
    <p class="marquee__hint">Lauftext-Band: Füge Texte hinzu, z. B. Motorräder, Bekleidung, Service.</p>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Lauftext-Band",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Beschriftung für Screenreader", "default": "Sortiment und Service" },
    { "type": "text", "id": "anchor_id", "label": "Anker-ID", "info": "Ziel des Hero-Pfeils (ID „nach-hero“). Ohne dieses Band trägst du die ID in der Service-Leiste ein." },
    { "type": "range", "id": "speed", "label": "Tempo", "min": 30, "max": 120, "step": 10, "unit": "px/s", "default": 60 }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "item",
      "name": "Begriff",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Motorräder" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lauftext-Band",
      "blocks": [
        { "type": "item", "settings": { "text": "Motorräder" } },
        { "type": "item", "settings": { "text": "Bekleidung" } },
        { "type": "item", "settings": { "text": "Teile & Zubehör" } },
        { "type": "item", "settings": { "text": "Accessoires" } },
        { "type": "item", "settings": { "text": "Service" } },
        { "type": "item", "settings": { "text": "Probefahrt" } }
      ]
    }
  ]
}
{% endschema %}
