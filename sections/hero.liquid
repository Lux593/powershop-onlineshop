{%- comment -%}
  Hero (nur Startseite): Vollbild. Slide 1 = Poster (LCP) mit Film darüber, Slide 2 und 3 = Foto mit Ken-Burns.
  Das Poster steht bewusst nicht in media.liquid: es braucht fetchpriority und srcset. Verhalten: assets/hero.js.
  Ohne JavaScript bleibt Slide 1 mit Poster, Text und Buttons stehen.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- assign dur = section.settings.autoplay_seconds | default: 8 -%}
  <section
    class="hero hero--{{ section.settings.overlay_direction | default: 'both' }} on-dark"
    aria-label="{{ section.settings.aria_label | escape }}"
    data-hero
    data-section-id="{{ section.id }}"
    style="--ov: {{ section.settings.overlay_opacity | default: 50 | at_least: 50 | divided_by: 100.0 }}; --hero-dur: {{ dur }}s"
  >
    {%- if section.settings.heading != blank -%}
      <h1 class="sr-only">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    <div class="hero__media">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_video = false
          assign still = block.settings.image
          assign still_asset = block.settings.image_asset
          if forloop.first
            if block.settings.video != blank or block.settings.video_asset != blank
              assign has_video = true
              if block.settings.poster != blank or block.settings.poster_asset != blank
                assign still = block.settings.poster
                assign still_asset = block.settings.poster_asset
              endif
            endif
          endif
        -%}
        <div
          class="hero__slide{% if forloop.first %} is-active{% endif %}{% if has_video %} hero__slide--video{% endif %}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        >
          {%- if still != blank -%}
            {%- if forloop.first -%}
              {{- still | image_url: width: 2400 | image_tag: widths: '640, 960, 1280, 1600, 1920, 2400', sizes: '100vw', class: 'hero__img', alt: block.settings.image_alt, loading: 'eager', fetchpriority: 'high', decoding: 'async' -}}
            {%- else -%}
              {{- still | image_url: width: 2400 | image_tag: widths: '640, 960, 1280, 1600, 1920, 2400', sizes: '100vw', class: 'hero__img', alt: block.settings.image_alt, loading: 'lazy', decoding: 'async' -}}
            {%- endif -%}
          {%- elsif still_asset != blank -%}
            {%- capture hidden_asset -%}{% render 'is-placeholder', asset: still_asset %}{%- endcapture -%}
            {%- if hidden_asset == blank -%}
              {%- if forloop.first -%}
                {%- if still_asset == 'hero-poster.webp' -%}
                  <img
                    class="hero__img"
                    src="{{ 'hero-poster.webp' | asset_url }}"
                    srcset="{{ 'hero-poster-960.webp' | asset_url }} 960w, {{ 'hero-poster.webp' | asset_url }} 1920w"
                    sizes="100vw"
                    width="1920"
                    height="1080"
                    alt="{{ block.settings.image_alt | escape }}"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  >
                {%- else -%}
                  <img class="hero__img" src="{{ still_asset | asset_url }}" width="1024" height="576" alt="{{ block.settings.image_alt | escape }}" loading="eager" fetchpriority="high" decoding="async">
                {%- endif -%}
              {%- else -%}
                <img class="hero__img" src="{{ still_asset | asset_url }}" width="1024" height="576" alt="{{ block.settings.image_alt | escape }}" loading="lazy" decoding="async">
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}

          {%- if has_video -%}
            {%- liquid
              assign src_desktop = ''
              assign src_mobile = ''
              assign src_webm = ''
              assign src_fallback = ''
              if block.settings.video != blank
                assign best_d = 0
                assign best_m = 0
                for source in block.settings.video.sources
                  if source.format == 'mp4'
                    if source.height <= 720 and source.height > best_d
                      assign best_d = source.height
                      assign src_desktop = source.url
                    endif
                    if source.height <= 540 and source.height > best_m
                      assign best_m = source.height
                      assign src_mobile = source.url
                    endif
                    if src_fallback == blank
                      assign src_fallback = source.url
                    endif
                  endif
                endfor
                if src_desktop == blank
                  assign src_desktop = src_fallback
                endif
              else
                assign base = block.settings.video_asset | strip
                assign src_desktop = base | append: '.mp4' | asset_url
                assign src_mobile = base | append: '-720.mp4' | asset_url
                assign src_webm = base | append: '.webm' | asset_url
              endif
            -%}
            {%- if src_desktop != blank -%}
              <video
                class="hero__video"
                muted
                playsinline
                loop
                preload="none"
                tabindex="-1"
                aria-hidden="true"
                disablepictureinpicture
                disableremoteplayback
                data-src="{{ src_desktop }}"
                {% if src_mobile != blank %}data-src-m="{{ src_mobile }}"{% endif %}
                {% if src_webm != blank %}data-src-webm="{{ src_webm }}"{% endif %}
              ></video>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
      <div class="hero__veil"></div>
      <div class="hero__dim"></div>
    </div>

    <div class="hero__caption">
      <div class="container hero__caption-inner">
        <div class="hero__content">
          <div class="hero__chips" role="tablist" aria-label="Modell wählen" data-hero-tabs>
            {%- for block in section.blocks -%}
              <button
                class="hero__chip"
                id="hero-tab-{{ block.id }}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="hero-panel-{{ block.id }}"
                {% unless forloop.first %}tabindex="-1"{% endunless %}
                data-index="{{ forloop.index0 }}"
              >{{ block.settings.label }}</button>
            {%- endfor -%}
          </div>

          {%- for block in section.blocks -%}
            {%- liquid
              assign bike = block.settings.product
              assign price_text = block.settings.price_text
              if price_text == blank and bike != blank
                assign price_text = bike.price | money_without_trailing_zeros
                if bike.metafields.bike.ab_preis.value
                  assign price_text = 'ab ' | append: price_text
                endif
              endif
              assign cta_label = block.settings.cta_label | default: block.settings.label
              assign detail_url = bike.url | default: block.settings.url
            -%}
            <div
              class="hero__panel"
              id="hero-panel-{{ block.id }}"
              role="tabpanel"
              aria-labelledby="hero-tab-{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
              {{ block.shopify_attributes }}
            >
              <h2 class="hero__poster" data-split="words">{{ block.settings.headline | default: block.settings.label }}</h2>
              <div class="hero__sub" data-stagger="90" data-reveal-delay="380">
                {%- if block.settings.blurb != blank -%}
                  <p class="hero__blurb">{{ block.settings.blurb }}</p>
                {%- endif -%}
                <div class="hero__offer">
                  {%- if price_text != blank -%}
                    <p class="hero__price">{{ price_text }}</p>
                  {%- endif -%}
                  <div class="hero__actions">
                    {%- if detail_url != blank -%}
                      <a class="btn btn--primary" href="{{ detail_url }}">{{ cta_label }}</a>
                    {%- endif -%}
                    {%- if block.settings.secondary_label != blank and block.settings.secondary_url != blank -%}
                      <a class="btn btn--outline-light" href="{{ block.settings.secondary_url }}">{{ block.settings.secondary_label }}</a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} Beide Steuerungen brauchen JavaScript: hero.js blendet die Pause-Taste ein und setzt das Ziel des Pfeils. {%- endcomment -%}
    <button class="hero__pause" type="button" aria-pressed="false" aria-label="Film und Bildwechsel pausieren" hidden>
      {% render 'icon', name: 'pause', class: 'hero__pause-pause' %}
      {% render 'icon', name: 'play', class: 'hero__pause-play' %}
    </button>
    {%- if section.settings.scroll_target != blank -%}
      <a class="hero__scroll" href="#{{ section.settings.scroll_target }}">
        <span>Weiter<span class="sr-only"> zum Inhalt</span></span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    {%- endif -%}
  </section>
{%- elsif request.design_mode -%}
  <section class="hero on-dark">
    <div class="container" style="padding-block:var(--s-8)"><p>Hero: Füge Slides hinzu (Modelle mit Bild, Text und Preis).</p></div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero mit Modell-Tabs",
  "tag": "div",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Seitenüberschrift (nur für Screenreader und Suchmaschinen)", "info": "Die Startseite braucht genau eine H1. Die großen Modellnamen darunter sind H2.", "default": "Power Shop: Harley-Davidson Neufahrzeuge, Teile und Bekleidung" },
    { "type": "text", "id": "aria_label", "label": "Beschriftung für Screenreader", "default": "Modelle 2026" },
    { "type": "range", "id": "overlay_opacity", "label": "Abdunklung über dem Bild", "info": "Stärke des Verlaufs, damit der Text lesbar bleibt. Der kleinste Wert ist 50 %, darunter geht die Schrift auf hellen Bildern unter.", "min": 50, "max": 90, "step": 5, "unit": "%", "default": 50 },
    {
      "type": "select",
      "id": "overlay_direction",
      "label": "Richtung des Verlaufs",
      "options": [
        { "value": "bottom", "label": "Von unten" },
        { "value": "left", "label": "Von links" },
        { "value": "both", "label": "Von unten und links" }
      ],
      "default": "both"
    },
    { "type": "range", "id": "autoplay_seconds", "label": "Bildwechsel nach", "info": "Die Modelle wechseln von selbst. Ein Klick auf einen Tab beendet den Wechsel, die Pause-Taste hält ihn an.", "min": 5, "max": 12, "step": 1, "unit": " s", "default": 8 },
    { "type": "text", "id": "scroll_target", "label": "Ziel des „Weiter“-Pfeils ohne JavaScript (ID)", "default": "nach-hero", "info": "Mit JavaScript scrollt der Pfeil automatisch zur nächsten Section. Die ID gilt nur als Rückfall." }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "slide",
      "name": "Modell",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab-Text", "default": "Road Glide" },
        { "type": "text", "id": "headline", "label": "Große Überschrift", "info": "Ohne Eingabe gilt der Tab-Text." },
        { "type": "text", "id": "blurb", "label": "Kurztext", "default": "Die feste Verkleidung für lange Strecken." },
        { "type": "header", "content": "Foto" },
        { "type": "image_picker", "id": "image", "label": "Bild", "info": "Empfohlen 16:9, mindestens 1920 Pixel breit. Beim ersten Slide nur ohne Film." },
        { "type": "text", "id": "image_asset", "label": "Standard-Bilddatei im Theme", "info": "Wird benutzt, solange kein Bild gewählt ist.", "default": "hero-ride-road.png" },
        { "type": "text", "id": "image_alt", "label": "Bildbeschreibung" },
        { "type": "header", "content": "Film (nur erster Slide)" },
        { "type": "video", "id": "video", "label": "Film", "info": "Ohne Auswahl läuft die Standarddatei. Kurzer Loop, 16:9, ohne Ton. Gilt nur für den ersten Slide." },
        { "type": "text", "id": "video_asset", "label": "Standard-Filmdatei im Theme", "info": "Dateiname ohne Endung. Das Theme sucht hero-loop.mp4, hero-loop-720.mp4 (mobil) und hero-loop.webm. Leer lassen für ein reines Foto. Die Standardwerte stehen bei jedem Modell, wirken aber nur im ersten Slide: Steht ein anderes Modell vorn, hier und beim Standbild den Eintrag leeren, sonst läuft der Road-Glide-Film mit dem Text dieses Modells.", "default": "hero-loop" },
        { "type": "image_picker", "id": "poster", "label": "Standbild zum Film", "info": "Erstes Bild des Films, erscheint sofort und wenn der Film nicht läuft." },
        { "type": "text", "id": "poster_asset", "label": "Standard-Standbild im Theme", "info": "Wird benutzt, solange kein Standbild gewählt ist.", "default": "hero-poster.webp" },
        { "type": "header", "content": "Angebot" },
        { "type": "product", "id": "product", "label": "Motorrad", "info": "Liefert Preis und Link." },
        { "type": "text", "id": "price_text", "label": "Preistext (überschreibt den Produktpreis)", "info": "Zum Beispiel: ab 31.500 €" },
        { "type": "text", "id": "cta_label", "label": "Button-Text", "info": "Ohne Eingabe gilt der Tab-Text." },
        { "type": "url", "id": "url", "label": "Link (falls kein Motorrad gewählt)" },
        { "type": "text", "id": "secondary_label", "label": "Zweiter Button", "default": "Probefahrt anfragen" },
        { "type": "url", "id": "secondary_url", "label": "Zweiter Button Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero mit Modell-Tabs",
      "blocks": [
        { "type": "slide" },
        {
          "type": "slide",
          "settings": {
            "label": "Street Glide",
            "blurb": "Die tiefe Scheibe für die offene Straße.",
            "image_asset": "hero-ride-street.png"
          }
        },
        {
          "type": "slide",
          "settings": {
            "label": "CVO",
            "blurb": "Die CVO-Ausstattung für die große Tour.",
            "image_asset": "hero-ride-cvo.png"
          }
        }
      ]
    }
  ]
}
{% endschema %}
