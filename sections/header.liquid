{%- liquid
  assign menu = linklists[section.settings.menu]
-%}

<header class="site-header" id="top" data-header>
  <div class="container header__bar">
    <button class="icon-btn header__burger" type="button" data-open="mobile-menu" aria-label="Menü öffnen">
      {% render 'icon', name: 'menu' %}
    </button>

    <a class="brand" href="{{ routes.root_url }}">
      <img
        class="brand__hd"
        src="{{ 'hd-bar-shield.png' | asset_url }}"
        alt=""
        width="49"
        height="40"
      >
      <span class="brand__divider" aria-hidden="true"></span>
      <span class="wordmark">Power<span>Shop</span></span>
      <span class="sr-only"> – zur Startseite</span>
    </a>

    <nav class="mainnav" aria-label="Hauptnavigation">
      <ul class="mainnav__list">
        {%- for link in menu.links -%}
          {%- liquid
            assign has_children = false
            if link.links.size > 0
              assign has_children = true
            endif
          -%}
          <li class="mainnav__item"{% if has_children %} data-mega="{{ link.handle }}"{% endif %}>
            <a
              class="mainnav__link{% if link.handle == 'sale' %} mainnav__link--sale{% endif %}"
              href="{{ link.url }}"
              {% if link.active or link.child_active %}aria-current="page"{% endif %}
            >
              {{- link.title | escape -}}
            </a>
            {%- if has_children -%}
              <button
                class="mainnav__toggle"
                type="button"
                aria-expanded="false"
                aria-controls="mega-{{ link.handle }}"
                aria-label="Untermenü {{ link.title | escape }}"
              >
                {% render 'icon', name: 'chevron-down' %}
              </button>
              <div class="mega on-dark" id="mega-{{ link.handle }}">
                {% render 'mega-menu', link: link, blocks: section.blocks, keep: section.settings.keep_order %}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__icons">
      <button class="icon-btn" type="button" data-open="search" aria-label="Suche öffnen">
        {% render 'icon', name: 'search' %}
      </button>
      {%- if shop.customer_accounts_enabled -%}
        {%- comment -%}
          Konto-Fenster von Shopify: Anmeldung und Links zu Bestellungen/Profil öffnen sich auf der Seite statt auf shopify.com.
          Das Skript fügt Shopify über content_for_header selbst ein, sobald das Element im HTML steht; der Knopf heißt von sich aus
          „Konto“. Aussehen in header.css, Lage unter dem Header in header.js. Den Code nach einer E-Mail-Anmeldung fragt Shopify auf
          der eigenen Seite ab (gestaltet im Admin, docs/kundenkonto.md). Abgemeldet zeigt der Knopf unser Symbol (Slot). Angemeldet
          steht bis zum Laden ein oranger Kreis an der Stelle der Initiale; danach blendet die Komponente ihn aus (kein Slot).
        {%- endcomment -%}
        <shopify-account class="header__account" menu="{{ section.settings.customer_account_menu | default: 'customer-account-main-menu' }}" data-account>
          {%- if customer -%}
            <span class="header__account-fallback"></span>
          {%- else -%}
            <span class="header__account-icon" slot="signed-out-avatar">{% render 'icon', name: 'user' %}</span>
          {%- endif -%}
        </shopify-account>
      {%- endif -%}
      <button class="icon-btn" type="button" data-open="cart-drawer" aria-label="Warenkorb, {{ cart.item_count }} Artikel" data-cart-trigger>
        {% render 'icon', name: 'shopping-bag' %}<span class="count" data-cart-count data-count="{{ cart.item_count }}">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
      </button>
    </div>
  </div>
</header>

<dialog class="drawer drawer--left mobile-menu" id="mobile-menu" aria-label="Menü" data-lenis-prevent>
  <div class="drawer__head">
    {%- comment -%} Logo und Schriftzug führen wie im Header zur Startseite {%- endcomment -%}
    <a class="mobile-menu__brand" href="{{ routes.root_url }}" aria-label="Power Shop, Startseite">
      <img src="{{ 'hd-bar-shield.png' | asset_url }}" alt="" width="49" height="40">
      <span class="wordmark">Power<span>Shop</span></span>
    </a>
    <button class="icon-btn" type="button" data-close aria-label="Menü schließen">{% render 'icon', name: 'x' %}</button>
  </div>
  <div class="drawer__body" data-lenis-prevent>
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        {%- comment -%}
          Gliederung wie im Megamenü (snippets/mega-menu.liquid): Ebene 2 mit Unterpunkten = Gruppe, zugeklappt wie die
          Hauptpunkte, darin Ebene 3 in derselben Reihenfolge (snippets/link-order.liquid); Ebene 2 ohne Unterpunkte =
          Gruppentitel als Link. „Alle …“ steht sichtbar unter den Gruppen (der Hauptpunkt selbst klappt hier nur auf), bei
          einer Seite wie Service heißt der Link „Service im Überblick“. Ohne Gruppen bilden alle Ebene-2-Punkte eine Liste.
        {%- endcomment -%}
        {%- liquid
          assign has_groups = false
          for child in link.links
            if child.links.size > 0
              assign has_groups = true
              break
            endif
          endfor
          if link.type == 'collection_link' or link.type == 'catalog_link' or link.url contains '/collections'
            assign overview_label = 'Alle ' | append: link.title
          else
            assign overview_label = link.title | append: ' im Überblick'
          endif
        -%}
        <details class="acc">
          <summary>{{ link.title | escape }}{% render 'icon', name: 'plus' %}</summary>
          <div class="acc__body">
            {%- if has_groups -%}
              {%- for group in link.links -%}
                {%- if group.links.size == 0 -%}
                  <a class="mobile-menu__group" href="{{ group.url }}">{{ group.title | escape }}</a>
                {%- else -%}
                  {%- capture order -%}{% render 'link-order', group: group, keep: section.settings.keep_order %}{%- endcapture -%}
                  {%- assign order = order | split: ',' -%}
                  <details class="mobile-menu__sub">
                    <summary class="mobile-menu__group">{{ group.title | escape }}{% render 'icon', name: 'plus' %}</summary>
                    <div class="mobile-menu__links">
                      {%- for position in order -%}
                        {%- assign index = position | plus: 0 -%}
                        {%- assign child = group.links[index] -%}
                        <a href="{{ child.url }}">{{ child.title | escape }}</a>
                      {%- endfor -%}
                    </div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
              <a href="{{ link.url }}"><strong>{{ overview_label | escape }}</strong></a>
            {%- else -%}
              {%- for child in link.links -%}
                <a href="{{ child.url }}">{{ child.title | escape }}</a>
              {%- endfor -%}
              <a href="{{ link.url }}"><strong>{{ overview_label | escape }}</strong></a>
            {%- endif -%}
          </div>
        </details>
      {%- else -%}
        <a class="mobile-menu__direct{% if link.handle == 'sale' %} mobile-menu__direct--sale{% endif %}" href="{{ link.url }}">
          {{- link.title | escape }}{% render 'icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
    {%- if shop.customer_accounts_enabled -%}
      {%- comment -%} Unter 490 px fehlt das Konto-Fenster im Header (header.css): hier führt der Knopf zu Shopifys Anmelde- bzw. Kontoseite {%- endcomment -%}
      <div class="mobile-menu__foot">
        <a class="btn btn--primary btn--block" href="{{ routes.account_url }}">{% render 'icon', name: 'user' %}{% if customer %}Kundenkonto{% else %}Anmelden{% endif %}</a>
      </div>
    {%- endif -%}
  </div>
</dialog>

{% render 'search-dialog', search_terms: section.settings.search_terms %}

{% schema %}
{
  "name": "Header",
  "class": "site-header-wrap",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hauptmenü",
      "default": "main-menu",
      "info": "Ebene 1 = Hauptpunkt, Ebene 2 = Spaltenüberschrift, Ebene 3 = Links. Kollektionen mit Bild erscheinen als Kacheln."
    },
    {
      "type": "text",
      "id": "keep_order",
      "label": "Spalten in eigener Reihenfolge",
      "default": "Fahrzeuge, Modellfamilien, Kollektionen",
      "info": "Die Links unter einer Spaltenüberschrift (Ebene 3) stehen alphabetisch. Spalten, deren Überschrift hier steht (kommagetrennt), behalten die Reihenfolge aus der Shopify-Navigation."
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Menü im Konto-Fenster",
      "default": "customer-account-main-menu",
      "info": "Links unter der Anmeldung im Konto-Fenster, z. B. Bestellungen und Profil. Voreingestellt ist das Menü der Kontoseiten."
    },
    {
      "type": "textarea",
      "id": "search_terms",
      "label": "Beliebte Suchen (eine pro Zeile)",
      "default": "Lederjacke\nStreet Glide\nAuspuff\nHelm\nGebraucht"
    }
  ],
  "blocks": [
    {
      "type": "teaser",
      "name": "Megamenü: Teaser-Kachel",
      "settings": [
        { "type": "text", "id": "parent", "label": "Hauptmenüpunkt (Titel)", "info": "Zum Beispiel Herren oder Teile & Zubehör." },
        { "type": "image_picker", "id": "image", "label": "Bild", "info": "Ohne Auswahl wird die Standarddatei unten benutzt." },
        { "type": "text", "id": "image_asset", "label": "Standard-Bilddatei im Theme", "info": "Dateiname aus den Theme-Dateien, z. B. mega-herren.jpg." },
        { "type": "text", "id": "label", "label": "Beschriftung" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "contact",
      "name": "Megamenü: Kontaktspalte",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "parent", "label": "Hauptmenüpunkt (Titel)", "default": "Service" },
        { "type": "text", "id": "title", "label": "Überschrift", "default": "Direkter Draht" }
      ]
    },
    {
      "type": "cta",
      "name": "Megamenü: Aufruf-Zeile",
      "settings": [
        { "type": "text", "id": "parent", "label": "Hauptmenüpunkt (Titel)", "default": "Motorräder" },
        { "type": "text", "id": "text", "label": "Text", "default": "Persönliche Beratung, Probefahrt und Finanzierung – direkt bei uns im Showroom." },
        { "type": "text", "id": "primary_label", "label": "Button 1", "default": "Probefahrt anfragen" },
        { "type": "url", "id": "primary_url", "label": "Button 1 Link" },
        { "type": "text", "id": "secondary_label", "label": "Button 2", "default": "Finanzierung anfragen" },
        { "type": "url", "id": "secondary_url", "label": "Button 2 Link" }
      ]
    }
  ]
}
{% endschema %}
